+      if (found) return found
+    }
+    return null
+  }
+
+  // The idle blank countdown is the timer with an idle run-up of its own.
+  function idleBlank(service) {
+    var objects = service.data || []
+    for (var i = 0; i < objects.length; i++) {
+      if (objects[i].idleMs !== undefined && objects[i].resumeMs !== undefined) return objects[i]
+    }
+    return null
+  }
+
+  function load(path) {
+    var component = Qt.createComponent("file://" + rootPath + path, Component.PreferSynchronous)
+    if (component.status !== Component.Ready) throw new Error(component.errorString())
+    return component
+  }
+
+  function runService() {
+    var service = load("/shell/plugins/lock/Service.qml").createObject(host, { omarchyPath: rootPath })
+    if (!service) throw new Error("Service failed to instantiate")
+    try {
+      var scanTimer = findByObjectName(service, "fingerprintScanTimer")
+      var monitor = findByObjectName(service, "fingerprintMonitor")
+      check(scanTimer !== null, "the service bounds a scan with a timer")
+      check(monitor !== null, "the service has a monitor process for fprintd")
+      if (!scanTimer || !monitor) return
+
+      check(monitor.command[0] === "gdbus" && monitor.command.indexOf("net.reactivated.Fprint") > 0,
+        "the monitor watches fprintd through gdbus")
+      check(!service.fingerprintMonitoring && !monitor.running, "nothing watches fprintd while the session is unlocked")
+
+      service.lockRequested = true
+      check(!service.fingerprintMonitoring, "locking without a reader enrolled watches nothing")
+      service.fingerprintConfigured = true
+      // Quickshell reports the process running once started, and stopped only
+      // once it has exited, so the stops below are read from the rule.
+      check(service.fingerprintMonitoring && monitor.running, "locking with a reader enrolled starts the watch")
+
+      service.fingerprintAuthenticating = false
+      service.applyFingerprintMonitorLine(root.presentLine)
+      check(!service.fingerprintScanning, "a finger outside the lock's own attempt is not its scan")
+
+      service.fingerprintAuthenticating = true
+      service.applyFingerprintMonitorLine("Monitoring signals from all objects owned by net.reactivated.Fprint")
+      check(!service.fingerprintScanning, "the monitor's header starts no scan")
+
+      service.applyFingerprintMonitorLine(root.presentLine)
+      check(service.fingerprintScanning, "a finger on the reader during an attempt starts the scan")
+      check(scanTimer.running, "a scan runs under its bound")
+
+      service.applyFingerprintMonitorLine(root.absentLine)
+      check(!service.fingerprintScanning && !scanTimer.running, "the finger leaving ends the scan")
+
+      service.applyFingerprintMonitorLine(root.presentLine)
+      service.settleFingerprintAttempt()
+      check(!service.fingerprintScanning && !scanTimer.running, "the attempt settling ends the scan")
+
+      service.fingerprintAuthenticating = true
+      service.applyFingerprintMonitorLine(root.presentLine)
+      service.resetAuthenticationState()
+      check(!service.fingerprintScanning && !scanTimer.running, "an unlock's reset ends the scan")
+
+      service.fingerprintAuthenticating = true
+      service.applyFingerprintMonitorLine(root.presentLine)
+      scanTimer.triggered()
+      check(!service.fingerprintScanning, "a scan the daemon never ends is bounded")
+
+      service.applyFingerprintMonitorLine(root.presentLine)
+      check(service.fingerprintScanning, "the scan can start again after its bound")
+      service.pauseFingerprint()
+      check(!service.fingerprintScanning, "blanking the displays ends the scan")
+      check(!service.fingerprintMonitoring, "nothing watches fprintd while the displays are off")
+      service.resumeFingerprint()
+      check(service.fingerprintMonitoring, "a wake watches fprintd again")
+
+      service.lockRequested = false
+      check(!service.fingerprintMonitoring, "unlocking stops the watch")
+
+      // A rejected finger shows for a moment, whatever the attempt's state,
+      // and the lock resetting, a blank or the moment passing ends it; the
+      // next finger landing doesn't, since pam_fprintd matches a finger left
+      // on the reader again at once. Other verdicts show nothing.
+      var rejectTimer = findByObjectName(service, "fingerprintRejectTimer")
+      check(rejectTimer !== null, "the service bounds a rejection with a timer")
+      if (!rejectTimer) return
+      service.lockRequested = true
+      service.fingerprintAuthenticating = true
+      service.applyFingerprintMonitorLine(root.matchedLine)
+      check(!service.fingerprintRejected, "a match is not a rejection")
+      service.applyFingerprintMonitorLine(root.retryLine)
+      check(!service.fingerprintRejected, "the reader asking to scan again is not a rejection")
+      service.applyFingerprintMonitorLine(root.rejectedLine)
+      check(service.fingerprintRejected && rejectTimer.running, "a rejected finger shows, under its bound")
+      service.applyFingerprintMonitorLine(root.absentLine)
+      check(service.fingerprintRejected, "the rejected finger leaving keeps the rejection showing")
+      service.fingerprintAuthenticating = false
+      service.applyFingerprintMonitorLine(root.rejectedLine)
+      check(service.fingerprintRejected, "a rejection that ends the attempt still shows")
+      rejectTimer.triggered()
+      check(!service.fingerprintRejected && !rejectTimer.running, "the rejection ends when its moment passes")
+      service.fingerprintAuthenticating = true
+      service.applyFingerprintMonitorLine(root.rejectedLine)
+      service.applyFingerprintMonitorLine(root.presentLine)
+      check(service.fingerprintRejected && service.fingerprintScanning, "the next finger landing starts its scan and keeps the rejection showing")
+      service.resetAuthenticationState()
+      check(!service.fingerprintRejected && !rejectTimer.running, "an unlock's reset ends the rejection")
+      service.fingerprintAuthenticating = true
+      service.applyFingerprintMonitorLine(root.rejectedLine)
+      service.pauseFingerprint()
+      check(!service.fingerprintRejected, "blanking the displays ends the rejection")
+      service.resumeFingerprint()
+
+      // A finger on the reader holds the idle blank, and so does the moment
+      // after a rejection; lifting it, the verdict or the moment passing
+      // starts a fresh run-up. Nothing here lets the blank fire: it would
+      // drive this machine's real displays.
+      var blank = idleBlank(service)
+      check(blank !== null, "the service has its idle blank countdown")
+      if (blank) {
+        service.clearFingerprintReject()
+        service.fingerprintAuthenticating = true
+        service.armBlankTimer()
+        check(blank.running, "the countdown runs while the lock waits")
+        service.applyFingerprintMonitorLine(root.presentLine)
+        check(!blank.running, "a finger on the reader holds the countdown")
+        service.applyFingerprintMonitorLine(root.absentLine)
+        check(blank.running, "the finger lifting starts a fresh run-up")
+        service.applyFingerprintMonitorLine(root.presentLine)
+        service.applyFingerprintMonitorLine(root.rejectedLine)
+        service.applyFingerprintMonitorLine(root.absentLine)
+        check(!blank.running, "the moment after a rejection keeps holding it")
+        findByObjectName(service, "fingerprintRejectTimer").triggered()
+        check(blank.running, "the rejection's moment passing starts a fresh run-up")
+        service.applyFingerprintMonitorLine(root.presentLine)
+        service.pauseFingerprint()
+        check(!blank.running, "a hold ending in a blank arms nothing while the displays are off")
+        service.resumeFingerprint()
+        service.applyFingerprintMonitorLine(root.presentLine)
+        service.lockRequested = false
+        service.resetAuthenticationState()
+        check(!blank.running, "a hold ending in an unlock arms nothing")
+        blank.stop()
+      }
+      service.lockRequested = false
+    } finally {
+      service.lockRequested = false
+      service.destroy()
+    }
+  }
+
+  // The monitor's lines reach the scan through the process's own parser,
+  // which the direct calls above don't exercise: a printf stands in for gdbus
+  // and prints one finger landing, read once the event loop turns. A new
+  // service asks fprintd-list about enrolment on creation, and that answer
+  // (none, in this scratch home) lands in the event loop too and settles any
+  // attempt, so the stand-in starts only once it has.
+  property var wiringService: null
+
+  function startWiring() {
+    var service = load("/shell/plugins/lock/Service.qml").createObject(host, { omarchyPath: rootPath })
+    if (!service) throw new Error("Service failed to instantiate for the wiring check")
+    wiringService = service
+    wiringTimer.phase = 1
+    wiringTimer.start()
+  }
+
+  function armWiring() {
+    var service = wiringService
+    var monitor = findByObjectName(service, "fingerprintMonitor")
+    monitor.command = ["printf", "%s\\n", root.presentLine]
+    service.fingerprintConfigured = true
+    service.lockRequested = true
+    service.fingerprintAuthenticating = true
+    check(!service.fingerprintScanning, "nothing is scanning before the monitor's line arrives")
+  }
+
+  function finishWiring() {
+    var service = wiringService
+    wiringService = null
+    if (!service) return
+    try {
+      check(service.fingerprintScanning, "a finger the monitor process reports starts the scan")
+    } finally {
+      service.lockRequested = false
+      service.destroy()
+    }
+  }
+
+  function writeResult() {
+    var payload = JSON.stringify({ ok: failures.length === 0, checks: checks, failures: failures })
+    if (resultPath) {
+      Quickshell.execDetached(["bash", "-lc", "printf '%s' '" + payload.replace(/'/g, "'\\''") + "' > '" + resultPath.replace(/'/g, "'\\''") + "'"])
+    }
+  }
+
+  Timer {
+    interval: 1
+    running: true
+    repeat: false
+    onTriggered: {
+      try {
+        root.runService()
+        root.startWiring()
+      } catch (error) {
+        root.failures.push("lock fingerprint scan fixture threw: " + error)
+        root.writeResult()
+      }
+    }
+  }
+
+  Timer {
+    id: wiringTimer
+    interval: 400
+    repeat: false
+    property int phase: 0
+    onTriggered: {
+      if (phase === 1) {
+        try {
+          root.armWiring()
+          phase = 2
+          start()
+        } catch (error) {
+          root.failures.push("lock fingerprint scan fixture threw: " + error)
+          root.writeResult()
+        }
+        return
+      }
+      try {
+        root.finishWiring()
+      } catch (error) {
+        root.failures.push("lock fingerprint scan fixture threw: " + error)
+      } finally {
+        root.writeResult()
+      }
+    }
+  }
+}
diff --git a/test/shell.d/lock-fingerprint-retry-test.sh b/test/shell.d/lock-fingerprint-retry-test.sh
index eb662b4..a88c441 100755
--- a/test/shell.d/lock-fingerprint-retry-test.sh
+++ b/test/shell.d/lock-fingerprint-retry-test.sh
@@ -179,4 +179,49 @@ assert(model.REACH_TIMEOUT_MS < 25000,
   "the reach bound lands before GDBus fails a stuck Claim at 25s and pam_fprintd's 30s verify timeout reports as a non-error message")
 assert(model.REACH_TIMEOUT_MS >= 10000,
   'the reach bound outlasts a slow device open, so a reader that takes seconds to claim is not killed mid-Claim on every attempt')
+
+// The scan: fprintd's finger-present property, as gdbus monitor prints its
+// changes, is what tells the lock the reader has a finger and is matching.
+const present = "/net/reactivated/Fprint/Device/0: org.freedesktop.DBus.Properties.PropertiesChanged ('net.reactivated.Fprint.Device', {'finger-present': <true>}, @as [])"
+// fprintd bundles both properties in one change when the finger it asked for
+// lands: this is the line a Mac's Touch ID produced.
+const landed = "/net/reactivated/Fprint/Device/0: org.freedesktop.DBus.Properties.PropertiesChanged ('net.reactivated.Fprint.Device', {'finger-needed': <false>, 'finger-present': <true>}, @as [])"
+const absent = "/net/reactivated/Fprint/Device/0: org.freedesktop.DBus.Properties.PropertiesChanged ('net.reactivated.Fprint.Device', {'finger-present': <false>}, @as [])"
+const needed = "/net/reactivated/Fprint/Device/0: org.freedesktop.DBus.Properties.PropertiesChanged ('net.reactivated.Fprint.Device', {'finger-needed': <true>}, @as [])"
+const verdict = "/net/reactivated/Fprint/Device/0: net.reactivated.Fprint.Device.VerifyStatus ('verify-match', true)"
+const header = 'Monitoring signals from all objects owned by net.reactivated.Fprint'
+const owner = 'The name net.reactivated.Fprint is owned by :1.42'
+
+assertEqual(model.parseFingerPresent(present), true, 'a finger landing on the reader reads as present')
+assertEqual(model.parseFingerPresent(landed), true, 'a finger landing bundled with the reader no longer asking reads as present')
+assertEqual(model.parseFingerPresent(absent), false, 'a finger leaving the reader reads as absent')
+assertEqual(model.parseFingerPresent(needed), null, "the reader asking for a finger is not a finger")
+assertEqual(model.parseFingerPresent(verdict), null, 'the verdict signal carries no finger status')
+assertEqual(model.parseFingerPresent(header), null, "the monitor's own header is not a finger")
+assertEqual(model.parseFingerPresent(owner), null, 'a name owner change is not a finger')
+assertEqual(model.parseFingerPresent(''), null, 'an empty line is not a finger')
+assertEqual(model.parseFingerPresent(undefined), null, 'no line is not a finger')
+
+// A scan the daemon never ends is bounded, and the bound leaves a slow reader
+// time to return its verdict first.
+assert(model.SCAN_TIMEOUT_MS >= 2000, 'the scan bound leaves a slow reader time to match')
+
+// The verdicts: a rejected finger is shown, a matched one unlocks, and the
+// reader's asks to retry are neither.
+const rejected = "/net/reactivated/Fprint/Device/0: net.reactivated.Fprint.Device.VerifyStatus ('verify-no-match', true)"
+const rejectedRetrying = "/net/reactivated/Fprint/Device/0: net.reactivated.Fprint.Device.VerifyStatus ('verify-no-match', false)"
+const retryScan = "/net/reactivated/Fprint/Device/0: net.reactivated.Fprint.Device.VerifyStatus ('verify-retry-scan', false)"
+const selected = "/net/reactivated/Fprint/Device/0: net.reactivated.Fprint.Device.VerifyFingerSelected ('right-index-finger',)"
+assertEqual(model.parseVerifyStatus(verdict), 'verify-match', 'a match reads as the match verdict')
+assertEqual(model.parseVerifyStatus(rejected), 'verify-no-match', 'a rejected finger reads as the no-match verdict')
+assertEqual(model.parseVerifyStatus(rejectedRetrying), 'verify-no-match', 'a rejected finger the daemon will retry still reads as no-match')
+assertEqual(model.parseVerifyStatus(retryScan), 'verify-retry-scan', "the reader's ask to scan again reads as its own result")
+assertEqual(model.parseVerifyStatus(selected), null, 'the finger selected signal is not a verdict')
+assertEqual(model.parseVerifyStatus(present), null, 'a finger status change is not a verdict')
+assertEqual(model.parseVerifyStatus(header), null, "the monitor's own header is not a verdict")
+assertEqual(model.parseVerifyStatus(''), null, 'an empty line is not a verdict')
+
+// A rejection shows long enough to be seen after the hand lifts, and ends
+// before the scan bound would, so a rejection never outlives a new scan.
+assert(model.REJECT_SHOW_MS >= 800 && model.REJECT_SHOW_MS < model.SCAN_TIMEOUT_MS, 'a rejection shows for a moment, shorter than the scan bound')
 JS
diff --git a/test/shell.d/lock-fingerprint-service-test.sh b/test/shell.d/lock-fingerprint-service-test.sh
index fb020ee..0a384a2 100644
--- a/test/shell.d/lock-fingerprint-service-test.sh
+++ b/test/shell.d/lock-fingerprint-service-test.sh
@@ -7,3 +7,14 @@ source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/base-test.sh"
 require_quickshell "lock fingerprint service test"
 
 run_qml_fixture lock-fingerprint-service "fingerprint service handles enrollment, failures and recovery" Ui Commons
+
+# A new lock service asks fprintd-list about enrolment, and the scan fixture's
+# wiring check waits for that answer before it sends its stand-in line. Where
+# this machine's lock has fingerprint PAM, the real fprintd-list can take
+# longer than that wait to start the daemon, and an answer of no enrolment
+# landing late would settle the attempt under the check. A stub answers at
+# once, with an enrolment.
+printf '#!/bin/bash\nprintf "Fingerprints for user %%s on Stub:\\n - #0: right-index-finger\\n" "$1"\n' >"$QML_FIXTURE_TMP/bin/fprintd-list"
+chmod +x "$QML_FIXTURE_TMP/bin/fprintd-list"
+
+run_qml_fixture lock-fingerprint-scan "fingerprint service shows the reader matching a finger" Ui Commons
