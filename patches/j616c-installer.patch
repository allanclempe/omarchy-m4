+                raise AsahiAdapterError("Mach-O Stage 1 has a malformed entry thread")
+            entry = u64(offset + 16 + 32 * 8)
+        offset += length
+    if offset != 32 + size:
+        raise AsahiAdapterError("Mach-O Stage 1 load command sizes disagree")
+    boot = segments.get("__TEXT_BOOT_EXEC")
+    if boot is not None and (boot[1] or boot[3]):
+        raise AsahiAdapterError("Mach-O Stage 1 has __TEXT_BOOT_EXEC, so iBoot would start SPTM")
+    for name in MACHO_REQUIRED:
+        if name not in segments:
+            raise AsahiAdapterError(f"Mach-O Stage 1 has no {name} segment")
+    base = segments["__TEXT"][0]
+    if segments["__TEXT"][2] != 0:
+        raise AsahiAdapterError("Mach-O Stage 1 __TEXT is not at offset 0")
+    for name, (vmaddr, vmsize, fileoff, filesize) in segments.items():
+        if vmsize and (vmaddr < base or fileoff != vmaddr - base or filesize != vmsize
+                       or fileoff + filesize > len(data)):
+            raise AsahiAdapterError(f"Mach-O Stage 1 {name} is not file-backed at its virtual offset")
+    code = segments["__TEXT_EXEC"]
+    if entry is None or not code[0] <= entry < code[0] + code[1]:
+        raise AsahiAdapterError("Mach-O Stage 1 entry point is outside __TEXT_EXEC")
+    return segments, entry
