+def confined_raw_stage1(device_class, os_firmware, members, *, common_allowed=False):
+    """The raw Stage 1 and confined Stage 2 this board boots, as a ConfinedStage1,
+    or None for every board outside BOARD_CONFINED_RAW_STAGE1. Refuses, before
+    any disk change, a payload or OS firmware the board cannot boot."""
+    if device_class not in BOARD_CONFINED_RAW_STAGE1:
+        return None
+    board = BOARD_STAGE1[device_class]
+    members = set(members)
+    if common_allowed and COMMON_STAGE1.member in members:
+        raise AsahiAdapterError(f"{board.macs} never boots the raw common Stage 1")
+    if board.os_firmware not in (None, os_firmware):
+        raise AsahiAdapterError(f"{board.macs} needs macOS {board.os_firmware} OS firmware")
+    if board.member not in members:
+        raise AsahiAdapterError(f"this image has no {board.member} for {board.macs}")
+    name = device_class[:-2] if device_class.endswith("ap") else device_class
+    own = f"{ESP_SOURCE}/m1n1/boot-ctxr-{name}.bin"
+    shared = f"{ESP_SOURCE}/{CONFINED_STAGE2}"
+    stage2 = own if own in members else shared if shared in members else None
+    if stage2 is None:
+        raise AsahiAdapterError(f"this image has no {own} for {board.macs}")
+    return ConfinedStage1(board.member, stage2)
