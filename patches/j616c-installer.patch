+    if u32(0) != 0xFEEDFACF or u32(4) != 0x0100000C:
+        raise AsahiAdapterError("Mach-O Stage 1 is not a 64-bit Arm Mach-O image")
+    if u32(12) != 12:
+        raise AsahiAdapterError("Mach-O Stage 1 is not a fileset boot object")
