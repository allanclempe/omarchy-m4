+def aura_macho(raw, entry_offset=0x800, boot_exec=False, filetype=12):
+    """A minimal aura-style fileset boot object carrying `raw` at the start of
+    __TEXT_EXEC, as aura's tools/macho_boot_object.py lays it out."""
+    import struct as _struct
+    page = 0x4000
+    base = 0xFFFFFE0007004000
+    code = (len(raw) + page - 1) // page * page + page
+    segments = [("__TEXT", 0, page), ("__TEXT_EXEC", page, code),
+                ("__PRELINK_INFO", page + code, page), ("__LINKEDIT", page * 2 + code, page)]
+    if boot_exec:
+        segments.append(("__TEXT_BOOT_EXEC", page * 3 + code, page))
+    commands = b""
+    for name, offset, size in segments:
+        commands += _struct.pack("<II16sQQQQIIII", 0x19, 72, name.encode(), base + offset, size,
+                                 offset, size, 1, 1, 0, 0)
+    registers = [0] * 34
+    registers[32] = base + page + entry_offset
+    commands += _struct.pack("<IIII", 5, 16 + 34 * 8, 6, 0x44) + _struct.pack("<34Q", *registers)
+    header = _struct.pack("<IIIIIIII", 0xFEEDFACF, 0x0100000C, 0xC0000002, filetype,
+                          len(segments) + 1, len(commands), 0, 0)
+    end = max(offset + size for _, offset, size in segments)
+    data = bytearray(end)
+    data[:len(header) + len(commands)] = header + commands
+    data[page:page + len(raw)] = raw
+    return bytes(data)
