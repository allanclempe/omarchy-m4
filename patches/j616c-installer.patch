+def fill_macho_stage1(obj, raw, filled):
+    """aura's boot object for `raw`, carrying `filled` (raw with its config
+    block filled) instead: the raw image sits unchanged at the start of
+    __TEXT_EXEC, then only zeros, entered at the raw entry point. Port of
+    aurora-installer MachOBootObject.fill (MIT)."""
+    segments, entry = _macho_layout(obj)
+    vmaddr, _, fileoff, filesize = segments["__TEXT_EXEC"]
+    if not raw or len(filled) != len(raw) or len(raw) > filesize:
+        raise AsahiAdapterError("Mach-O Stage 1 does not carry this Stage 1")
+    if entry != vmaddr + MACHO_RAW_ENTRY:
+        raise AsahiAdapterError("Mach-O Stage 1 does not enter this Stage 1 at its entry point")
+    start, end = fileoff, fileoff + len(raw)
+    if obj[start:end] != raw or obj[end:fileoff + filesize].count(0) != fileoff + filesize - end:
+        raise AsahiAdapterError("Mach-O Stage 1 does not carry this Stage 1")
+    return obj[:start] + filled + obj[end:]
