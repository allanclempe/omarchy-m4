             stub.AlsFWCollection, stub.ISPFWCollection, stub.subprocess = old_als, old_isp, old_process
 
 
+# Boards whose camera has a sensor setfile beyond upstream's registry, and
+# must get it: the installer's firmware.tar is what first boot installs, and a
+# camera without its setfile streams dark and noisy (omarchy-m4 OMS-22).
+BOARD_CAMERA_SETFILES = {
+    # The 16-inch M4 Max's IMX958 (aura's isp-cam.c: 0x958, 0x22240106, 0x6ff4).
+    "j616cap": ("the 16-inch M4 Max", ("2224_01XX",)),
+}
+
+
+@contextlib.contextmanager
+def _camera_tuning_collector(installer):
+    """Collect camera setfiles with the upgraded registry on every Mac.
+
+    Upstream's ISPFWCollection knows only its own setfile list, so a sensor
+    it lacks (IMX958 on the J616c) is never collected, however the registry
+    was extended. The Neo keeps its own collector, which already upgrades the
+    registry and checks its sensors."""
+    upstream = getattr(asahi_firmware, "isp", None)
+    device = getattr(getattr(installer, "sysinfo", None), "device_class", "")
+    if upstream is None or not hasattr(stub, "ISPFWCollection") or device == "j700ap":
+        yield
+        return
+    board, required = BOARD_CAMERA_SETFILES.get(device, ("", ()))
+    upgraded = omarchy_isp.collection_class(upstream)
+
+    class CameraCollection(upgraded):
+        def __init__(self, source_path):
+            super().__init__(source_path)
+            names = {name for name, _ in self.files()}
+            missing = {"apple/isp_" + sensor + ".dat" for sensor in required} - names
+            if missing:
+                raise AsahiAdapterError(
+                    f"{board} camera tuning is missing: " + ", ".join(sorted(missing)))
+
+    old_isp = stub.ISPFWCollection
+    stub.ISPFWCollection = CameraCollection
+    try:
+        yield
+    except omarchy_isp.IspError as error:
+        raise AsahiAdapterError(f"camera tuning collection failed: {error}") from error
+    finally:
+        stub.ISPFWCollection = old_isp
+
+
