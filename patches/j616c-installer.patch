+# Boards that enroll their raw Stage 1 from BOARD_STAGE1 but chainload the
+# confined Stage 2 (m1n1/boot-ctxr.bin). Recovery enrolls it as "raw-ctxr":
+# `bputil -nc` (Kernel CTRR off), then `kmutil configure-boot --raw`, so no
+# execute window is armed and every core is free (aura docs/macho-boot-object.md,
+# "Use"; recovery-enroll.md). The Stage 2 comes from the board's
+# esp/m1n1/boot-ctxr-<board>.bin, otherwise from esp/m1n1/boot-ctxr.bin.
+#
+# The J616c (T6041) boots only this way. Its padded Mach-O object reboots the
+# Mac about every 10 s before aura shows anything, the same object Aurora's own
+# ExecuteWindowTool makes (kcrz 153141248), and an unpadded object is confined
+# with no window, so aura's Stage 2 refuses to start the OS ("this Stage 1 did
+# not arm a large enough window"), as aura's docs say it must. A raw Stage 1
+# enrolled after `bputil -nc` booted a fresh install to Linux on all 14 cores
+# (omarchy-m4 OMS-24).
+BOARD_CONFINED_RAW_STAGE1 = {"j616cap"}
+RAW_CTXR_BOOT_MODE = "raw-ctxr"
