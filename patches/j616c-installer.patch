+def _macho_layout(data):
+    """aura's fileset boot object: segments file-backed at their virtual
+    offsets, entered in __TEXT_EXEC, with no __TEXT_BOOT_EXEC (iBoot would
+    start SPTM). Port of aurora-installer MachOBootObject.layout (MIT)."""
+    def u32(offset):
+        if offset < 0 or offset + 4 > len(data):
+            raise AsahiAdapterError("Mach-O Stage 1 is truncated")
+        return struct.unpack_from("<I", data, offset)[0]
+
+    def u64(offset):
+        return u32(offset) | u32(offset + 4) << 32
