+def _stage_tree(source, destination, skip=()):
+    """Copy a firmware tree's names, bytes and modes, keeping symlinks.
+
+    shutil.copytree also copies BSD file flags (copystat calls chflags), and
+    every file on the sealed system volume carries SIP's `restricted` flag,
+    which not even root may set: copying /usr/share/firmware/wifi that way
+    fails with EPERM. The archive needs none of that metadata.
+    """
+    os.makedirs(destination)
+    for root, dirs, files in os.walk(source):
+        relative = os.path.relpath(root, source)
+        target = destination if relative == "." else os.path.join(destination, relative)
+        if relative == ".":
+            dirs[:] = [name for name in dirs if name not in skip]
+            files = [name for name in files if name not in skip]
+        for name in list(dirs):
+            path = os.path.join(root, name)
+            if os.path.islink(path):
+                # os.walk does not descend into a linked directory: keep the link.
+                os.symlink(os.readlink(path), os.path.join(target, name))
+                dirs.remove(name)
+            else:
+                os.mkdir(os.path.join(target, name))
+        for name in files:
+            path, copy = os.path.join(root, name), os.path.join(target, name)
+            if os.path.islink(path):
+                os.symlink(os.readlink(path), copy)
+            else:
+                shutil.copyfile(path, copy)
+                os.chmod(copy, os.stat(path).st_mode & 0o777)
+
