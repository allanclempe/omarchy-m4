+# Aurora's update-m1n1 hands Stage 2 to its bootchain.py (aurora-stage2.sh).
+aurora_lib=$(dirname -- "$(realpath -- "$0")")/../lib/omarchy-mac/boot/aurora-stage2.sh
+[[ -r $aurora_lib ]] || aurora_lib=$(dirname -- "$(realpath -- "$0")")/../lib/aurora-stage2.sh
+# shellcheck source=../lib/aurora-stage2.sh
+source "$aurora_lib"
+
 # m1n1 stage 2, built the way this update-m1n1 builds it.
 script=$(path /usr/bin/update-m1n1)
 [[ -r $script ]] || fail "/usr/bin/update-m1n1 is not installed"
