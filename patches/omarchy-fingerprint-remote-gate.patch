+++ b/migrations/1795113315.sh
@@ -0,0 +1,25 @@
+echo "Skip fingerprint auth for sudo over SSH (password when no one is at the sensor)"
+
+# Existing fingerprint setups gate sudo's pam_fprintd behind the lid state
+# only, so a sudo over SSH blocks on a reader no one is at for the full
+# pam_fprintd timeout before offering the password. Insert the remote session
+# gate in front of the clamshell gate, which sits immediately before
+# pam_fprintd: success=2 skips both. New setups already get it from
+# omarchy-setup-security-fingerprint. A stack missing pam_fprintd or the
+# clamshell gate was edited by an administrator and is left alone: there
+# success=2 could skip something else. polkit's stack gets no gate: its
+# helper runs in no user session, so the gate couldn't tell SSH apart.
+#
+# The gate points at the fixed /usr/bin path the omarchy package always
+# provides, so it keeps working across package installs and dev-link.
+# pam_exec needs a literal absolute path — it does not expand env vars.
+
+gate="auth      [success=2 default=ignore] pam_exec.so quiet /usr/bin/omarchy-session-remote"
+pam=/etc/pam.d/sudo
+
+if [[ -f $pam ]] &&
+  grep -q 'pam_fprintd\.so' "$pam" &&
+  grep -q 'omarchy-hw-laptop-closed' "$pam" &&
+  ! grep -q 'omarchy-session-remote' "$pam"; then
+  sudo sed -i "/omarchy-hw-laptop-closed/i $gate" "$pam"
+fi
