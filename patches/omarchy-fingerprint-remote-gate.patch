+#!/bin/bash
+
+# omarchy:summary=Returns true when the calling session is remote (SSH), so no one is at this machine
+# omarchy:hidden=true
+
+# The process whose session is asked about is the caller: the shell that ran
+# this, or, from pam_exec, the program authenticating (sudo). logind marks a
+# session that came in over the network, OpenSSH's and Tailscale's alike,
+# Remote=yes; a seat's desktop session is not, and the terminals it opens run
+# under the user manager, in no session at all, so a PID logind doesn't know
+# counts as local. So does a logind that doesn't answer: this runs in sudo's
+# PAM stack where fingerprint login is set up, so it must neither hold up
+# every sudo nor skip the reader on a guess.
+pid=${OMARCHY_SESSION_PID:-$PPID}
+
+session=$(busctl --timeout=2 call org.freedesktop.login1 /org/freedesktop/login1 \
+  org.freedesktop.login1.Manager GetSessionByPID u "$pid" 2>/dev/null) || exit 1
+session=${session#o \"}
+session=${session%\"}
+[[ $session == /org/freedesktop/login1/session/* ]] || exit 1
+
+remote=$(busctl --timeout=2 get-property org.freedesktop.login1 "$session" \
+  org.freedesktop.login1.Session Remote 2>/dev/null) || exit 1
+[[ $remote == "b true" ]]
