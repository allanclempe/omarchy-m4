diff --git a/test/shell.d/session-remote-test.sh b/test/shell.d/session-remote-test.sh
new file mode 100644
index 00000000..873d4d97
--- /dev/null
+++ b/test/shell.d/session-remote-test.sh
@@ -0,0 +1,81 @@
+#!/bin/bash
+
+set -euo pipefail
+
+source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/base-test.sh"
+
+test_tmp=$(mktemp -d)
+trap 'rm -rf "$test_tmp"' EXIT
+
+stub_bin="$test_tmp/bin"
+mkdir -p "$stub_bin"
+busctl_log="$test_tmp/busctl.log"
+
+# logind as busctl shows it: the session the asked-about PID belongs to
+# (OMARCHY_TEST_SESSION, none when empty) and that session's Remote property
+# (OMARCHY_TEST_REMOTE; "fail" for a logind that doesn't answer).
+cat >"$stub_bin/busctl" <<'SH'
+#!/bin/bash
+printf '%s\n' "$*" >>"$BUSCTL_LOG"
+case "$*" in
+  *"GetSessionByPID u $OMARCHY_TEST_SESSION_PID")
+    [[ -n ${OMARCHY_TEST_SESSION:-} ]] || { echo "Call failed: PID $OMARCHY_TEST_SESSION_PID does not belong to any known session" >&2; exit 1; }
+    printf 'o "%s"\n' "$OMARCHY_TEST_SESSION"
+    ;;
+  *"$OMARCHY_TEST_SESSION org.freedesktop.login1.Session Remote")
+    [[ ${OMARCHY_TEST_REMOTE:-} != "fail" ]] || exit 1
+    printf '%s\n' "${OMARCHY_TEST_REMOTE:-}"
+    ;;
+  *) exit 1 ;;
+esac
+SH
+chmod +x "$stub_bin/busctl"
+
+run_remote() {
+  : >"$busctl_log"
+  BUSCTL_LOG="$busctl_log" PATH="$stub_bin:$PATH" \
+    OMARCHY_TEST_SESSION_PID=4242 OMARCHY_SESSION_PID=4242 \
+    OMARCHY_TEST_SESSION="$1" OMARCHY_TEST_REMOTE="$2" \
+    "$ROOT/bin/omarchy-session-remote"
+}
+
+ssh_session=/org/freedesktop/login1/session/_318
+seat_session=/org/freedesktop/login1/session/_32
+
+run_remote "$ssh_session" 'b true' || fail "an SSH session is remote"
+pass "an SSH session is remote"
+
+if run_remote "$seat_session" 'b false'; then
+  fail "the seat's session is not remote"
+fi
+pass "the seat's session is not remote"
+
+# A terminal on the desktop runs under the user manager, in no session logind
+# knows, and so does a sudo it runs. That is local, and nothing more is asked.
+if run_remote '' ''; then
+  fail "a process in no session is not remote"
+fi
+(( $(wc -l <"$busctl_log") == 1 )) || fail "a process in no session is asked about once" "$(cat "$busctl_log")"
+pass "a process in no session is not remote, and logind isn't asked for more"
+
+for answer in '' 'not-a-property' 'fail'; do
+  if run_remote "$ssh_session" "$answer"; then
+    fail "a logind that does not answer leaves the session local" "$answer"
+  fi
+done
+pass "a logind that does not answer leaves the session local"
+
+# This runs in sudo's PAM stack, so a stalled logind must not
+# hold up every sudo.
+run_remote "$ssh_session" 'b true' >/dev/null
+! grep -qv '^--timeout=2 ' "$busctl_log" || fail "logind gets a short timeout, not busctl's 25 s" "$(cat "$busctl_log")"
+pass "logind gets a short timeout, not busctl's 25 s"
+
+# From pam_exec the caller is the program authenticating, this script's
+# parent; here that is the bash that runs it, whose PID the stub expects. The
+# trailing exit keeps that bash from replacing itself with the one command.
+: >"$busctl_log"
+BUSCTL_LOG="$busctl_log" PATH="$stub_bin:$PATH" OMARCHY_TEST_SESSION="$ssh_session" OMARCHY_TEST_REMOTE='b true' \
+  bash -c 'OMARCHY_TEST_SESSION_PID=$$ "$1"; exit $?' bash "$ROOT/bin/omarchy-session-remote" ||
+  fail "without a PID given, the parent's session is asked about" "$(cat "$busctl_log")"
+pass "without a PID given, the parent's session is asked about"
