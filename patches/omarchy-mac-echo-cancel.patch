@@ -0,0 +1,17 @@
+[Unit]
+Description=Cancel the speakers' echo in the built-in microphones
+After=pipewire.service wireplumber.service
+PartOf=graphical-session.target pipewire.service
+Wants=pipewire.service
+
+[Service]
+Type=simple
+ExecCondition=/usr/bin/omarchy-hw-apple-silicon
+# Only a Mac with a microphone array (the HPAI card, or the J700's AOP card).
+ExecCondition=/usr/bin/grep -Eqs "\\[AppleJ[0-9]+(HPAI|AOP) *\\]" /proc/asound/cards
+ExecStart=/usr/bin/pipewire -c /usr/share/omarchy-mac/echo-cancel.conf
+Restart=on-failure
+RestartSec=2
+
+[Install]
+WantedBy=graphical-session.target
