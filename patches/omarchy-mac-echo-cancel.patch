index 0000000..88e0c7a
--- /dev/null
+++ b/omarchy-mac/test/echo-cancel-test.sh
@@ -0,0 +1,46 @@
+#!/bin/bash
+set -euo pipefail
+source "$(dirname "$0")/base-test.sh"
+stage=$(mktemp -d)
+trap 'rm -rf "$stage"' EXIT
+"$ROOT/install" "$stage"
+unit=$stage/usr/lib/systemd/user/omarchy-echo-cancel.service
+config=$stage/usr/share/omarchy-mac/echo-cancel.conf
+[[ -f $unit && -f $config ]] || fail 'the echo canceller unit and its configuration are staged'
+[[ $(readlink "$stage/usr/lib/systemd/user/graphical-session.target.wants/omarchy-echo-cancel.service") == ../omarchy-echo-cancel.service ]] ||
+  fail 'the echo canceller is enabled for every user'
+grep -qx 'ExecStart=/usr/bin/pipewire -c /usr/share/omarchy-mac/echo-cancel.conf' "$unit" || fail 'the unit runs the staged configuration'
+grep -qx 'PartOf=graphical-session.target pipewire.service' "$unit" || fail 'the canceller restarts with PipeWire'
+pass 'the echo canceller is a user unit, enabled for every user, that restarts with PipeWire'
+
+# Only a Mac with a microphone array runs it: the condition's own pattern,
+# as systemd unescapes it, against /proc/asound/cards lines.
+pattern=$(sed -n 's/^ExecCondition=\/usr\/bin\/grep -Eqs "\(.*\)" \/proc\/asound\/cards$/\1/p' "$unit" | sed 's/\\\\/\\/g')
+[[ -n $pattern ]] || fail 'the unit checks /proc/asound/cards for a microphone array'
+for card in ' 0 [AppleJ616HPAI  ]: macaudio - MacBook Pro J616 HPAI' ' 3 [AppleJ700AOP   ]: macaudio - MacBook Neo J700 AOP'; do
+  grep -Eq "$pattern" <<<"$card" || fail 'a microphone array card runs the canceller' "$card"
+done
+for card in ' 1 [AppleJ616      ]: macaudio - MacBook Pro J616' ' 2 [AppleJack      ]: macaudio - MacBook Pro J616 Jack' ' 0 [AppleJ474      ]: macaudio - Mac mini J474' ' 4 [U0x46d0x825    ]: USB-Audio - USB Device'; do
+  ! grep -Eq "$pattern" <<<"$card" || fail 'a card without the microphone array does not run the canceller' "$card"
+done
+pass 'the canceller runs only where the microphone array card exists'
+
+# Its names match the mapper, which selects its source, and the audio hints,
+# which hide its streams.
+python3 - "$config" "$stage/usr/bin/omarchy-audio-asahi-mic-map" "$stage/usr/share/omarchy-platform/audio.json" <<'PY'
+import json
+import re
+import sys
+config, mapper, hints = (open(path).read() for path in sys.argv[1:])
+names = dict(re.findall(r'(capture|source|sink)\.props = \{\s*node\.name = "([^"]+)"', config))
+assert names == {'capture': 'omarchy_echo_cancel.capture', 'source': 'omarchy_echo_cancel.source', 'sink': 'omarchy_echo_cancel.reference'}, names
+assert "CANCELLED = '%s'" % names['source'] in mapper
+assert re.search(r'target\.object = "omarchy_asahi_mic"\s*node\.dont-fallback = true', config), 'it captures the mapping only'
+assert 'monitor.mode = true' in config and 'playback.props' not in config, 'the reference is the default output monitor (sink.props)'
+assert re.search(r'priority\.session = 1\b', config), 'WirePlumber never chooses it before the mapper'
+hidden = [re.compile(pattern) for pattern in json.loads(hints)['hidden']]
+for name in (names['capture'], names['sink']):
+    assert any(pattern.fullmatch(name) for pattern in hidden), name
+PY
+pass 'the echo canceller names match the mapper and the audio hints'
+
