diff --git a/omarchy-mac/share/omarchy-mac/echo-cancel.conf b/omarchy-mac/share/omarchy-mac/echo-cancel.conf
new file mode 100644
index 0000000..98a817c
--- /dev/null
+++ b/omarchy-mac/share/omarchy-mac/echo-cancel.conf
@@ -0,0 +1,47 @@
+# The echo canceller omarchy-echo-cancel.service runs as a PipeWire client of
+# its own. asahi-audio's speaker graph changes the sound after an app plays it,
+# so the app's own canceller leaves the speakers' echo in the microphones.
+context.spa-libs = {
+  audio.convert.* = audioconvert/libspa-audioconvert
+  support.* = support/libspa-support
+}
+context.modules = [
+  { name = libpipewire-module-protocol-native }
+  { name = libpipewire-module-client-node }
+  { name = libpipewire-module-adapter }
+  { name = libpipewire-module-echo-cancel
+    args = {
+      library.name = aec/libspa-aec-webrtc
+      monitor.mode = true
+      audio.rate = 48000
+      # The microphone path already sets its own gain.
+      aec.args = { webrtc.gain_control = false webrtc.noise_suppression = true webrtc.high_pass_filter = true }
+      # The microphone mapping (omarchy-audio-asahi-mic-map), never another source.
+      capture.props = {
+        node.name = "omarchy_echo_cancel.capture"
+        target.object = "omarchy_asahi_mic"
+        node.dont-fallback = true
+        node.passive = true
+        audio.channels = 1
+        audio.position = [ MONO ]
+      }
+      # The mapper selects it once it carries the microphone; the low priority
+      # keeps WirePlumber from choosing it before then.
+      source.props = {
+        node.name = "omarchy_echo_cancel.source"
+        node.description = "MacBook Microphone"
+        media.class = Audio/Source
+        priority.session = 1
+        audio.channels = 1
+        audio.position = [ MONO ]
+      }
+      # In monitor mode the reference reads sink.props: the default output's monitor.
+      sink.props = {
+        node.name = "omarchy_echo_cancel.reference"
+        node.passive = true
+        audio.channels = 2
+        audio.position = [ FL FR ]
+      }
+    }
+  }
+]
