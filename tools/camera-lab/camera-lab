#!/bin/bash
# camera-lab: toggle the J616c camera's filters, effects and settings and see
# the difference live. Runs on the Mac, in the logged-in user's session.
#
#   camera-lab live [--size WxH]       preview window + menu (the main mode)
#   camera-lab clip [options]          record one clip, render every variant
#                                      on the same frames, measure, compare
#   camera-lab virtual [options]       the post-filter stack to a v4l2loopback
#                                      camera (for Meet); untested
#   camera-lab status                  what the camera and the lab are set to
#   camera-lab restore                 put back the denoise.conf and V4L2
#                                      values from before the lab, reload
#   camera-lab check                   test every dependency and the nodes
#
# Layer 1 is what every app sees: aurora-camera-denoise's denoise.conf and the
# camera's V4L2 controls. Layer 2 is the lab's own FFmpeg filters, applied in
# the preview only. See README.md.
set -euo pipefail

CL_HERE=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)
CL_HELPER=${CAMERA_LAB_HELPER:-$CL_HERE/camera-lab-helper.py}
CL_PRESET_FILES=${CAMERA_LAB_PRESETS:-$CL_HERE/presets.conf:${XDG_CONFIG_HOME:-$HOME/.config}/camera-lab/presets.conf}
CL_CONF=${CAMERA_LAB_DENOISE_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/aurora-camera-denoise/denoise.conf}
CL_STATE=${CAMERA_LAB_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/camera-lab}
CL_OUT=${CAMERA_LAB_OUT:-$HOME/camera-lab}
CL_DEV=${CAMERA_LAB_DEVICE:-/dev/video0}
CL_SERVICE=aurora-camera-denoise
CL_EFFECTS_LIB=${CAMERA_LAB_EFFECTS_LIB:-/usr/lib/aurora-camera-denoise/libaurora-camera-effects.so}
CL_FPS=30

# denoise.conf keys, in the order the lab writes them, and the values offered.
CL_CONF_KEYS=(mode temporal temporal-backend backend low-light-frame-rate threads
  enter-gain exit-gain enter-noise exit-noise)
declare -A CL_CONF_CHOICES=(
  [mode]="auto on off"
  [temporal]="on off"
  [temporal-backend]="auto cpu ave gpu"
  [backend]="auto cpu"
  [low-light-frame-rate]="on off"
  [threads]="0 1 2 4"
  [enter-gain]="1536 2304 3584"
  [exit-gain]="1280 1792 2816"
  [enter-noise]="0 7"
  [exit-noise]="0 5"
)
declare -A CL_CONF_HELP=(
  [mode]="auto: low-light stage by gain/noise; on: always; off: frames untouched (raw)"
  [temporal]="the CPU temporal filter on every frame"
  [temporal-backend]="ave has no device and gpu isn't built on this Mac: both fall back to cpu"
  [backend]="low-light stage: auto = Neural Engine (1920x1080 only); cpu"
  [low-light-frame-rate]="on: the camera may drop to 25 or 15 fps for longer exposures"
  [threads]="CPU worker threads (0 = one); no effect on the picture"
  [enter-gain]="low-light stage on at this gain (256 = 1x); research: 2304 for dim light"
  [exit-gain]="low-light stage off below this gain; research: 1792"
  [enter-noise]="noise trigger; 0 disables it (research: 0 on this sensor)"
  [exit-noise]="noise trigger's exit level"
)
CL_V4L2_KEYS=(power_line_frequency exposure_dynamic_framerate)
declare -A CL_V4L2_CHOICES=([power_line_frequency]="0 1 2" [exposure_dynamic_framerate]="0 1")
declare -A CL_V4L2_HELP=(
  [power_line_frequency]="anti-flicker: 0 off, 1 = 50 Hz, 2 = 60 Hz; match the mains"
  [exposure_dynamic_framerate]="frame rate may drop for exposure; the filter sets it from low-light-frame-rate on each stream start"
)

# The speck graph: 255 where luma is more than 24 below its 3x3 median, 128
# more than 24 above (the research's section 7).
CL_SPECK_GRAPH="extractplanes=y,split[a][b];[b]median=radius=1[m];[a][m]lut2=c0='if(gt(y-x,24),255,if(gt(x-y,24),128,0))'"

cl_say() { printf '%s\n' "$*" >&2; }
cl_die() { printf 'camera-lab: %s\n' "$*" >&2; exit 1; }

# --- Presets (layer 2) -------------------------------------------------------

declare -a CL_PNAMES=()
declare -A CL_PCHAIN=() CL_PNOTE=() CL_PFLAGS=()

# cl_load_presets FILE...: read `name|chain|note|flags` lines; later files
# override earlier names. Bad lines are reported and skipped.
cl_load_presets() {
  local file line name chain note flags rest n
  for file; do
    [[ -r $file ]] || continue
    n=0
    while IFS= read -r line || [[ -n $line ]]; do
      n=$((n + 1))
      line=${line%$'\r'}
      [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
      IFS='|' read -r name chain note flags rest <<<"$line"
      name=${name#"${name%%[![:space:]]*}"}
      name=${name%"${name##*[![:space:]]}"}
      if [[ -n ${rest:-} ]]; then
        cl_say "camera-lab: $file:$n: more than 4 fields (a chain can't contain |); skipped"
        continue
      fi
      if [[ ! $name =~ ^[A-Za-z0-9._-]+$ || -z ${chain//[[:space:]]/} ]]; then
        cl_say "camera-lab: $file:$n: needs name|chain[|note[|flags]]; skipped"
        continue
      fi
      [[ -n ${CL_PCHAIN[$name]+x} ]] || CL_PNAMES+=("$name")
      CL_PCHAIN[$name]=$chain
      CL_PNOTE[$name]=${note:-}
      CL_PFLAGS[$name]=${flags//[[:space:]]/}
    done <"$file"
  done
}

cl_load_default_presets() {
  local -a files
  IFS=: read -r -a files <<<"$CL_PRESET_FILES"
  cl_load_presets "${files[@]}"
}

# cl_has_flag NAME FLAG
cl_has_flag() { [[ ,${CL_PFLAGS[$1]:-}, == *",$2,"* ]]; }

# cl_namespace_chain PREFIX CHAIN: rename the chain's [labels] to
# [PREFIX_label] so two stages never share a label.
cl_namespace_chain() {
  local prefix=$1 chain=$2 out='' re='^([^[]*)\[([A-Za-z0-9_]+)\](.*)$'
  while [[ $chain =~ $re ]]; do
    out+="${BASH_REMATCH[1]}[${prefix}_${BASH_REMATCH[2]}]"
    chain=${BASH_REMATCH[3]}
  done
  printf '%s' "$out$chain"
}

# cl_stack IN OUT CHAIN...: one graph that runs the chains in order, from link
# label IN to OUT (either empty for the graph's open input or output).
cl_stack() {
  local in=$1 out=$2 i=0 n graph='' link next chain
  shift 2
  n=$#
  ((n)) || set -- null
  n=$#
  link=$in
  for chain; do
    i=$((i + 1))
    if ((i == n)); then next=$out; else next=cl$i; fi
    [[ -z $graph ]] || graph+=';'
    [[ -z $link ]] || graph+="[$link]"
    graph+=$(cl_namespace_chain "p$i" "$chain")
    [[ -z $next ]] || graph+="[$next]"
    link=$next
  done
  printf '%s' "$graph"
}

# cl_chains NAME...: the chains of the named presets, one per line, or fail
# naming the unknown one.
cl_chains() {
  local name
  for name; do
    [[ -n ${CL_PCHAIN[$name]+x} ]] || { cl_say "camera-lab: no preset named $name"; return 1; }
    printf '%s\n' "${CL_PCHAIN[$name]}"
  done
}

# cl_view_graph VIEW W H [NAME...]: the preview's lavfi graph.
#   split: left half as the camera gives it, right half through the stack,
#          from the same frame, with a thin divider
#   b:     the whole frame through the stack
#   a:     no graph (prints nothing)
# Every stack ends scaled back to W x H, so a size-changing preset shows at
# the same size as the camera's frame.
cl_view_graph() {
  local view=$1 w=$2 h=$3 chains
  shift 3
  local -a stack=()
  chains=$(cl_chains "$@") || return 1
  [[ -z $chains ]] || mapfile -t stack <<<"$chains"
  case $view in
    a) ;;
    b) cl_stack '' '' "${stack[@]}" "scale=$w:$h" ;;
    split)
      printf 'split[A][B];[A]crop=iw/2:ih:0:0[L];'
      cl_stack B R "${stack[@]}" \
        "scale=$w:$h,crop=iw/2:ih:iw/2:0,drawbox=x=0:y=0:w=2:h=ih:color=white@0.6:t=fill"
      printf ';[L][R]hstack'
      ;;
    *) cl_say "camera-lab: unknown view $view"; return 1 ;;
  esac
}

# cl_render_graph W H NAME...: the clip mode's graph: the stack, back to W x H
# and NV12.
cl_render_graph() {
  local w=$1 h=$2 chains
  shift 2
  local -a stack=()
  chains=$(cl_chains "$@") || return 1
  [[ -z $chains ]] || mapfile -t stack <<<"$chains"
  cl_stack '' '' "${stack[@]}" "scale=$w:$h,format=nv12"
}

# cl_filters_in CHAIN: the FFmpeg filter names a chain uses, one per line.
cl_filters_in() {
  local chain=$1 seg
  local -
  set -f
  chain=$(sed -E "s/'[^']*'//g; s/\[[A-Za-z0-9_]+\]/,/g" <<<"$chain")
  local IFS=',;'
  for seg in $chain; do
    seg=${seg#"${seg%%[![:space:]]*}"}
    seg=${seg%%=*}
    [[ -n $seg ]] && printf '%s\n' "$seg"
  done
  return 0
}

# --- denoise.conf (layer 1) ---------------------------------------------------

declare -A CL_SET=()
declare -a CL_SET_EXTRA=()

# cl_conf_parse FILE: the [denoise] keys of FILE into CL_SET. Keys the lab
# doesn't know are kept, in order, in CL_SET_EXTRA.
cl_conf_parse() {
  local file=$1 line section='' key val known
  CL_SET=()
  CL_SET_EXTRA=()
  [[ -r $file ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    [[ -z $line || $line == \#* || $line == \;* ]] && continue
    if [[ $line =~ ^\[(.*)\]$ ]]; then
      section=${BASH_REMATCH[1]}
      continue
    fi
    [[ $section == denoise ]] || continue
    [[ $line =~ ^([A-Za-z0-9_-]+)[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
    key=${BASH_REMATCH[1]}
    val=${BASH_REMATCH[2]}
    if [[ -z ${CL_SET[$key]+x} ]]; then
      known=0
      [[ " ${CL_CONF_KEYS[*]} " == *" $key "* ]] && known=1
      ((known)) || CL_SET_EXTRA+=("$key")
    fi
    CL_SET[$key]=$val
  done <"$file"
}

# cl_conf_render: CL_SET as a denoise.conf, known keys in CL_CONF_KEYS order,
# then the others. An empty value means the key is left out (its default).
cl_conf_render() {
  local key
  printf '[denoise]\n'
  for key in "${CL_CONF_KEYS[@]}" "${CL_SET_EXTRA[@]}"; do
    [[ -n ${CL_SET[$key]:-} ]] && printf '%s = %s\n' "$key" "${CL_SET[$key]}"
  done
  return 0
}

# cl_conf_summary: CL_SET on one line.
cl_conf_summary() {
  local key out=''
  for key in "${CL_CONF_KEYS[@]}" "${CL_SET_EXTRA[@]}"; do
    [[ -n ${CL_SET[$key]:-} ]] && out+="${out:+, }$key = ${CL_SET[$key]}"
  done
  printf '%s' "${out:-(all defaults)}"
}

cl_backup_file() { printf '%s/denoise.conf.orig' "$CL_STATE"; }
cl_absent_file() { printf '%s/denoise.conf.absent' "$CL_STATE"; }
cl_has_backup() { [[ -e $(cl_backup_file) || -e $(cl_absent_file) ]]; }

# cl_conf_backup: keep the user's denoise.conf (or that there was none) once;
# a backup left by an earlier run is kept, as it holds the original.
cl_conf_backup() {
  mkdir -p -- "$CL_STATE"
  cl_has_backup && return 0
  if [[ -e $CL_CONF ]]; then
    cp -p -- "$CL_CONF" "$(cl_backup_file)"
  else
    : >"$(cl_absent_file)"
  fi
}

# cl_conf_write: back up the original once, then write CL_SET atomically.
cl_conf_write() {
  local tmp
  cl_conf_backup
  mkdir -p -- "$(dirname -- "$CL_CONF")"
  tmp=$(mktemp "$CL_CONF.camera-lab.XXXXXX")
  cl_conf_render >"$tmp"
  if [[ -e $(cl_backup_file) ]]; then
    chmod --reference="$(cl_backup_file)" -- "$tmp"
  else
    chmod 644 -- "$tmp"
  fi
  mv -f -- "$tmp" "$CL_CONF"
}

# cl_conf_restore: put the original back byte for byte (or remove the lab's
# file if there was none). Returns 1 if there was nothing to restore.
cl_conf_restore() {
  if [[ -e $(cl_backup_file) ]]; then
    mkdir -p -- "$(dirname -- "$CL_CONF")"
    cp -p -- "$(cl_backup_file)" "$CL_CONF"
    rm -f -- "$(cl_backup_file)"
  elif [[ -e $(cl_absent_file) ]]; then
    rm -f -- "$CL_CONF" "$(cl_absent_file)"
  else
    return 1
  fi
}

# cl_conf_original: parse the user's own conf (the backup if the lab has
# written over it) into CL_SET.
cl_conf_original() {
  if [[ -e $(cl_backup_file) ]]; then
    cl_conf_parse "$(cl_backup_file)"
  elif [[ -e $(cl_absent_file) ]]; then
    cl_conf_parse /dev/null
  else
    cl_conf_parse "$CL_CONF"
  fi
}

cl_service_reload() {
  if systemctl --user is-active --quiet "$CL_SERVICE"; then
    systemctl --user reload "$CL_SERVICE"
  else
    cl_say "camera-lab: $CL_SERVICE isn't running, so the change waits for its next start"
  fi
}

cl_effective_config() {
  command -v aurora-camera-denoise >/dev/null || { echo "(aurora-camera-denoise not installed)"; return 0; }
  aurora-camera-denoise --print-config 2>&1 | tail -n 1 | sed 's/^camera-denoise: //'
}

# cl_journal_lines [SINCE]: the filter's last stream lines this boot.
cl_journal_lines() {
  local -a since=(-b)
  [[ -n ${1:-} ]] && since=(--since "$1")
  journalctl --user -u "$CL_SERVICE" "${since[@]}" -o cat --no-pager 2>/dev/null |
    grep -E ': [0-9]+x[0-9]+@[0-9/]+, |backend [a-z]+ unavailable|: (board|mode) ' |
    sed 's/^camera-denoise: //' | tail -n "${2:-2}" || true
}

# --- V4L2 controls ------------------------------------------------------------

cl_v4l2_get() {
  v4l2-ctl -d "$CL_DEV" -C "$1" 2>/dev/null | sed -n "s/^$1: *//p"
}

cl_v4l2_backup() {
  local key file=$CL_STATE/v4l2.orig
  mkdir -p -- "$CL_STATE"
  [[ -e $file ]] && return 0
  for key in "${CL_V4L2_KEYS[@]}"; do
    printf '%s=%s\n' "$key" "$(cl_v4l2_get "$key")"
  done >"$file.tmp"
  mv -f -- "$file.tmp" "$file"
}

cl_v4l2_set() {
  cl_v4l2_backup
  v4l2-ctl -d "$CL_DEV" -c "$1=$2"
}

cl_v4l2_restore() {
  local file=$CL_STATE/v4l2.orig key val
  [[ -e $file ]] || return 1
  while IFS='=' read -r key val; do
    [[ -n $key && -n $val ]] && v4l2-ctl -d "$CL_DEV" -c "$key=$val"
  done <"$file"
  rm -f -- "$file"
}

# --- Readings -----------------------------------------------------------------

cl_iio_dir() {
  local d
  for d in "${CAMERA_LAB_IIO:-}" /sys/bus/iio/devices/iio:device*; do
    [[ -n $d && -r $d/in_illuminance_input ]] && { printf '%s' "$d"; return 0; }
  done
  return 1
}

# cl_readings: gain, exposure, light level and colour temperature, one line.
# Gain and exposure are only live while something streams.
cl_readings() {
  local gain exp lux='' ct='' iio out
  gain=$(cl_v4l2_get gain)
  exp=$(cl_v4l2_get exposure_time_absolute)
  if iio=$(cl_iio_dir); then
    lux=$(cat "$iio/in_illuminance_input" 2>/dev/null || true)
    ct=$(cat "$iio/in_colortemp_input" 2>/dev/null || true)
  fi
  out=''
  [[ -n $gain ]] && out+=$(awk -v g="$gain" 'BEGIN { printf "gain %.2fx (%d)", g / 256, g }')
  [[ -n $exp ]] && out+=$(awk -v e="$exp" 'BEGIN { printf ", exposure %.1f ms", e / 10 }')
  [[ -n $lux ]] && out+=$(awk -v l="$lux" 'BEGIN { printf ", %.1f lux", l }')
  [[ -n $ct ]] && out+=$(awk -v c="$ct" 'BEGIN { printf ", %.0f K", c }')
  printf '%s' "${out#, }"
}

# --- PipeWire nodes -----------------------------------------------------------

CL_RAW_ID='' CL_RAW_NAME='' CL_FILTER_ID='' CL_FILTER_NAME='' CL_FILTER_STATE='' CL_FRAMING=false

# cl_discover [PW_DUMP_FILE]: find the ISP's node and the filter's default
# output. Returns 1 if the filter's node isn't there.
cl_discover() {
  local role id serial state name desc framing lines
  CL_RAW_ID='' CL_RAW_NAME='' CL_FILTER_ID='' CL_FILTER_NAME='' CL_FILTER_STATE='' CL_FRAMING=false
  if [[ -n ${1:-} ]]; then
    lines=$(python3 "$CL_HELPER" nodes "$1") || return 1
  else
    lines=$(pw-dump 2>/dev/null | python3 "$CL_HELPER" nodes) || return 1
  fi
  while IFS=$'\t' read -r role id serial state name desc framing; do
    case $role in
      raw) [[ -z $CL_RAW_ID ]] && CL_RAW_ID=$id CL_RAW_NAME=$name ;;
      filter)
        if [[ -z $CL_FILTER_ID ]]; then
          CL_FILTER_ID=$id CL_FILTER_NAME=$name CL_FILTER_STATE=$state
          [[ $framing == framing=true ]] && CL_FRAMING=true
        fi
        ;;
    esac
  done <<<"$lines"
  : "$serial" "$desc"
  [[ -n $CL_FILTER_NAME ]]
}

cl_require_nodes() {
  cl_discover || cl_die "no aurora-camera-denoise output in PipeWire: is $CL_SERVICE running? (camera-lab check)"
}

# --- Preview (live) -----------------------------------------------------------

CL_RUN='' CL_PREVIEW_PID='' CL_W=1920 CL_H=1080 CL_VIEW=split
declare -a CL_STACK=()
CL_TOUCHED=0 CL_EFFECTS_TOUCHED=0

cl_run_dir() {
  [[ -n $CL_RUN ]] && return 0
  CL_RUN=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/camera-lab.XXXXXX")
}

# cl_capture_cmd W H NODE [FRAMES]: the GStreamer pipeline that writes the
# node's NV12 frames to stdout.
cl_capture_cmd() {
  local w=$1 h=$2 node=$3 frames=${4:-}
  local -a cmd=(gst-launch-1.0 -q pipewiresrc "target-object=$node")
  [[ -n $frames ]] && cmd+=("num-buffers=$frames")
  cmd+=('!' "video/x-raw,format=NV12,width=$w,height=$h,framerate=$CL_FPS/1" '!' fdsink fd=1)
  printf '%q ' "${cmd[@]}"
}

# cl_preview_cmd W H NODE SOCKET INPUT_CONF: capture piped into mpv.
cl_preview_cmd() {
  local w=$1 h=$2 node=$3 sock=$4 input=$5
  local -a mpv=(mpv --no-config "--input-conf=$input" --demuxer=rawvideo
    --demuxer-rawvideo-mp-format=nv12 "--demuxer-rawvideo-w=$w" "--demuxer-rawvideo-h=$h"
    "--demuxer-rawvideo-fps=$CL_FPS" --profile=low-latency --untimed --no-cache --no-audio
    "--input-ipc-server=$sock" '--title=Camera lab' --force-window=immediate --keep-open=no
    --osd-level=1 --autofit-larger=70%x70% -)
  printf '%s| ' "$(cl_capture_cmd "$w" "$h" "$node")"
  printf '%q ' "${mpv[@]}"
}

cl_preview_alive() { [[ -n $CL_PREVIEW_PID ]] && kill -0 "$CL_PREVIEW_PID" 2>/dev/null; }

cl_preview_start() {
  local cmd i
  cl_run_dir
  cat >"$CL_RUN/input.conf" <<'EOF'
t vf toggle @cl ; show-text "camera lab: post filters toggled (t)"
EOF
  rm -f -- "$CL_RUN/mpv.sock"
  cmd=$(cl_preview_cmd "$CL_W" "$CL_H" "$CL_FILTER_NAME" "$CL_RUN/mpv.sock" "$CL_RUN/input.conf")
  setsid bash -c "$cmd" </dev/null >"$CL_RUN/preview.log" 2>&1 &
  CL_PREVIEW_PID=$!
  mkdir -p -- "$CL_STATE"
  printf '%s\n' "$CL_PREVIEW_PID" >"$CL_STATE/preview.pid"
  for ((i = 0; i < 150; i++)); do
    [[ -S $CL_RUN/mpv.sock ]] && break
    cl_preview_alive || break
    sleep 0.1
  done
  if [[ ! -S $CL_RUN/mpv.sock ]]; then
    cl_say "camera-lab: the preview didn't start; its log:"
    tail -n 20 -- "$CL_RUN/preview.log" >&2 || true
    return 1
  fi
  cl_apply_view
}

cl_preview_stop() {
  local i pid=$CL_PREVIEW_PID
  [[ -z $pid && -r $CL_STATE/preview.pid ]] && pid=$(<"$CL_STATE/preview.pid")
  if [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null; then
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    for ((i = 0; i < 50; i++)); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    kill -KILL -- "-$pid" 2>/dev/null || true
  fi
  CL_PREVIEW_PID=''
  rm -f -- "$CL_STATE/preview.pid"
}

# cl_json_str STRING: STRING as a JSON string.
cl_json_str() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\t'/\\t}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  printf '"%s"' "$s"
}

# cl_vf_json GRAPH: the mpv command that sets the preview's filter to GRAPH
# (labelled @cl), or clears it when GRAPH is empty.
cl_vf_json() {
  if [[ -z $1 ]]; then
    printf '{"command":["set_property","vf",[]]}'
  else
    printf '{"command":["set_property","vf",[{"name":"lavfi","label":"cl","enabled":true,"params":{"graph":%s}}]]}' \
      "$(cl_json_str "$1")"
  fi
}

cl_mpv() { python3 "$CL_HELPER" ipc "$CL_RUN/mpv.sock" "$@"; }

# cl_graph_check GRAPH W H: run GRAPH over three W x H frames in FFmpeg, print
# its error. mpv takes any graph over IPC and only logs a failure, passing the
# frames through unfiltered, so the lab checks first.
cl_graph_check() {
  ffmpeg -v error -nostdin -f lavfi -i "color=gray:s=$2x$3:r=30:d=0.1" -vf "$1" -f null - 2>&1 >/dev/null | head -n 3
  return "${PIPESTATUS[0]}"
}

cl_stack_label() {
  local IFS='>'
  if ((${#CL_STACK[@]})); then printf '%s' "${CL_STACK[*]}" | sed 's/>/ > /g'; else printf 'none'; fi
}

cl_view_label() {
  case $1 in
    split) printf 'split: left as apps see it, right + post filters' ;;
    a) printf 'full A: as apps see it' ;;
    b) printf 'full B: + post filters' ;;
  esac
}

# cl_apply_view [VIEW]: set the preview's graph for VIEW (default CL_VIEW).
cl_apply_view() {
  local view=${1:-$CL_VIEW} graph msg err
  cl_preview_alive || return 0
  graph=$(cl_view_graph "$view" "$CL_W" "$CL_H" "${CL_STACK[@]}") || return 1
  msg="$(cl_view_label "$view") | post: $(cl_stack_label) | t toggles"
  if [[ -n $graph ]] && ! err=$(cl_graph_check "$graph" "$CL_W" "$CL_H"); then
    cl_say "camera-lab: FFmpeg can't run this graph, so the preview keeps the last one:"
    cl_say "  $graph" "  $err"
    return 1
  fi
  if ! cl_mpv "$(cl_vf_json "$graph")" >"$CL_RUN/ipc.log" 2>&1; then
    cl_say "camera-lab: mpv refused the filter graph:"
    cl_say "  $graph"
    cat -- "$CL_RUN/ipc.log" >&2
    return 1
  fi
  cl_mpv "{\"command\":[\"set_property\",\"osd-msg1\",$(cl_json_str "$msg")]}" >/dev/null 2>&1 || true
  mkdir -p -- "$CL_STATE"
  printf '%s\n' "${CL_STACK[@]}" >"$CL_STATE/stack"
}

# --- Effects ------------------------------------------------------------------

cl_effects_installed() { [[ -e $CL_EFFECTS_LIB ]]; }

# cl_effects_set PARAMS: e.g. '"camera.background" "blur"'
cl_effects_set() {
  pw-cli set-param "$CL_FILTER_ID" Props "{ params = [ $1 ] }" >/dev/null
  CL_EFFECTS_TOUCHED=1
}

cl_effects_off() {
  [[ -n $CL_FILTER_ID ]] || cl_discover || return 0
  pw-cli set-param "$CL_FILTER_ID" Props \
    '{ params = [ "camera.background" "off" "camera.framing" false ] }' >/dev/null 2>&1 || true
}

# --- Restore ------------------------------------------------------------------

# cl_restore_all: everything the lab changed, back. Safe to run twice.
cl_restore_all() {
  local did=0
  cl_preview_stop
  if cl_conf_restore; then
    did=1
    cl_say "camera-lab: restored $CL_CONF"
  fi
  if cl_v4l2_restore 2>/dev/null; then
    did=1
    cl_say "camera-lab: restored the camera's V4L2 controls"
  fi
  if ((CL_EFFECTS_TOUCHED)); then
    cl_effects_off
    CL_EFFECTS_TOUCHED=0
  fi
  if ((did || CL_TOUCHED)); then
    cl_service_reload || true
  fi
  CL_TOUCHED=0
  return 0
}

cl_cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  cl_restore_all || true
  [[ -n $CL_RUN ]] && rm -rf -- "$CL_RUN"
  exit "$rc"
}

cl_arm_trap() {
  trap cl_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM HUP
}

# cl_start_session: put back what an interrupted run left, then note the
# user's own settings.
cl_start_session() {
  if cl_has_backup || [[ -e $CL_STATE/v4l2.orig ]]; then
    cl_say "camera-lab: an earlier run left its backup; restoring it first"
    cl_restore_all
  fi
  cl_arm_trap
  cl_conf_original
}

# cl_conf_apply: write CL_SET and reload the filter.
cl_conf_apply() {
  cl_conf_write
  CL_TOUCHED=1
  cl_service_reload
}

# --- Snapshot -----------------------------------------------------------------

# cl_notes: every setting and reading, for notes.txt.
cl_notes() {
  local key
  printf 'camera-lab notes, %s\n\n' "$(date '+%Y-%m-%d %H:%M:%S %z')"
  printf 'Size: %sx%s NV12 from %s\n' "$CL_W" "$CL_H" "${CL_FILTER_NAME:-?}"
  printf 'Readings: %s\n\n' "$(cl_readings)"
  printf 'Layer 1, denoise.conf as written:\n'
  cl_conf_render | sed 's/^/  /'
  printf 'Effective (--print-config): %s\n' "$(cl_effective_config)"
  printf 'Filter log, last stream:\n'
  cl_journal_lines '' 3 | sed 's/^/  /'
  printf 'V4L2:'
  for key in "${CL_V4L2_KEYS[@]}"; do printf ' %s=%s' "$key" "$(cl_v4l2_get "$key")"; done
  printf '\n\nLayer 2 (post filters, in order): %s\n' "$(cl_stack_label)"
  for key in "${CL_STACK[@]}"; do printf '  %s: %s\n' "$key" "${CL_PCHAIN[$key]}"; done
  printf 'Effects: %s\n' "$(cl_effects_installed && echo "library installed" || echo "not installed")"
  printf '\nGraphs:\n  split: %s\n  B: %s\n' \
    "$(cl_view_graph split "$CL_W" "$CL_H" "${CL_STACK[@]}")" \
    "$(cl_view_graph b "$CL_W" "$CL_H" "${CL_STACK[@]}")"
}

cl_snapshot() {
  local dir
  dir=$CL_OUT/$(date +%Y%m%d-%H%M%S)
  mkdir -p -- "$dir"
  cl_notes >"$dir/notes.txt"
  if cl_preview_alive; then
    # split shows A and B of one frame; A and B are then taken a moment apart,
    # B after a second so temporal filters have settled.
    local view pause
    for view in split a b; do
      pause=0.5
      [[ $view == b ]] && pause=1.2
      { cl_apply_view "$view" && sleep "$pause" &&
        cl_mpv "{\"command\":[\"screenshot-to-file\",$(cl_json_str "$dir/${view^^}.png"),\"video\"]}" >/dev/null; } ||
        cl_say "camera-lab: no $view screenshot"
    done
    mv -f -- "$dir/SPLIT.png" "$dir/split.png" 2>/dev/null || true
    cl_apply_view || true
  else
    cl_say "camera-lab: no preview running; wrote the notes only"
  fi
  printf '%s' "$dir"
}

