    "background blur") cl_effects_set '"camera.background" "blur"' ;;
    "background replace"*)
      path=$(gum file "$HOME") || return 0
      cl_effects_set "\"camera.background.path\" $(cl_json_str "$path") \"camera.background\" \"replace\""
      ;;
