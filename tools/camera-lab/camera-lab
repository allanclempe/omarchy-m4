cl_live() {
  local pick dir
  while (($#)); do
    case $1 in
      --size) [[ ${2:-} =~ ^(1920x1080|1280x720)$ ]] || cl_die "--size takes 1920x1080 or 1280x720"
        CL_W=${2%x*} CL_H=${2#*x}; shift 2 ;;
      *) cl_die "live: unknown option $1" ;;
    esac
  done
  for dep in gum mpv gst-launch-1.0 python3 pw-dump v4l2-ctl; do
    command -v "$dep" >/dev/null || cl_die "$dep is missing (camera-lab check)"
  done
  [[ -n ${XDG_RUNTIME_DIR:-} ]] || cl_die "XDG_RUNTIME_DIR isn't set (over SSH: export XDG_RUNTIME_DIR=/run/user/\$(id -u))"
  [[ -n ${WAYLAND_DISPLAY:-}${DISPLAY:-} ]] || cl_die "no display: run it in the desktop session, or set WAYLAND_DISPLAY"
  cl_load_default_presets
  cl_require_nodes
  if [[ $CL_FILTER_STATE == running ]]; then
    gum confirm "Another app is using the camera now. The lab's camera changes reach it too. Go on?" || exit 0
  fi
  cl_start_session
  cl_run_dir
  cl_preview_start || cl_die "the preview didn't start"
  while true; do
    clear
    cl_status_block
    pick=$(cl_choose --header "Camera lab: t in the preview window flips the post filters" \
      "View: split (same frame, left as apps see it, right + post filters)" \
      "View: full A (as apps see it)" \
      "View: full B (+ post filters)" \
      "Camera (layer 1: denoise.conf, V4L2, resolution)..." \
      "Post filters (layer 2: FFmpeg, preview only)..." \
      "Effects$(cl_effects_installed || echo ": not installed")..." \
      "Snapshot (A, B, split and notes into $CL_OUT)" \
      "Refresh" \
      "Restore and quit") || pick="Restore and quit"
    case $pick in
      "View: split"*) CL_VIEW=split; cl_apply_view || true ;;
      "View: full A"*) CL_VIEW=a; cl_apply_view || true ;;
      "View: full B"*) CL_VIEW=b; cl_apply_view || true ;;
      Camera*) cl_menu_camera ;;
      Post*) cl_menu_post ;;
      Effects*) cl_menu_effects ;;
      Snapshot*)
        dir=$(cl_snapshot)
        gum style --foreground 76 "Saved to $dir"
        sleep 1.5
        ;;
      Refresh) ;;
      "Restore and quit") break ;;
    esac
    if ! cl_preview_alive; then
      gum confirm "The preview window closed. Open it again?" && cl_preview_start || break
    fi
  done
  cl_restore_all
  cl_say "camera-lab: settings restored; $CL_CONF is as before the lab"
}

# --- clip ---------------------------------------------------------------------

# cl_parse_cdn_metrics: aurora-camera-denoise-metrics output on stdin to
# `noise_y noise_u noise_v psnr_y ssim_y`, space separated.
cl_parse_cdn_metrics() {
  awk '
    /^temporal_std/ { for (i = 2; i <= NF; i++) { split($i, kv, "="); t[kv[1]] = kv[2] } }
    /^psnr_y=/ { for (i = 1; i <= NF; i++) { split($i, kv, "="); t[kv[1]] = kv[2] } }
    END {
      if (t["y"] == "") exit 1
      printf "%s %s %s %s %s\n", t["y"], t["cb"], t["cr"], t["psnr_y"], t["ssim_y"]
    }'
}

# cl_parse_bench FIELD: a key=value FIELD from aurora-camera-denoise-bench's
# output on stdin.
cl_parse_bench() {
  tr ' ' '\n' | sed -n "s/^$1=//p" | head -n 1
}

# cl_parse_kv FIELD: the same for the helper's one-line outputs.
cl_parse_kv() { cl_parse_bench "$1"; }

# cl_frames FILE W H FIRST COUNT: COUNT NV12 frames of FILE from FIRST, to stdout.
cl_frames() {
  dd if="$1" bs="$(($2 * $3 * 3 / 2))" skip="$4" count="$5" status=none
}

cl_ffraw() { # W H: ffmpeg reading NV12 frames from stdin
  printf '%s\n' ffmpeg -v error -nostdin -f rawvideo -pix_fmt nv12 -s "$1x$2" -framerate "$CL_FPS" -i -
}

# cl_measure W H RAW FILE FIRST COUNT WORK: the section 7 metrics of FILE's
# frames [FIRST, FIRST+COUNT), as `noise_y noise_u noise_v psnr ssim edge dark
# bright` (n/a where a tool is missing). WORK/raw.grad is the reference edges.
cl_measure() {
  local w=$1 h=$2 raw=$3 file=$4 first=$5 count=$6 work=$7 m='' sp ed
  local -a ff
  local -
  set +o pipefail
  mapfile -t ff < <(cl_ffraw "$w" "$h")
  if command -v aurora-camera-denoise-metrics >/dev/null; then
    m=$(aurora-camera-denoise-metrics "$w" "$h" "$raw" "$file" "$first" "$count" | cl_parse_cdn_metrics) || m=''
  fi
  [[ -n ${m:-} ]] || m='n/a n/a n/a n/a n/a'
  sp=$(cl_frames "$file" "$w" "$h" "$first" "$count" |
    "${ff[@]}" -vf "$CL_SPECK_GRAPH" -f rawvideo -pix_fmt gray - |
    python3 "$CL_HELPER" specks "$w" "$h")
  cl_frames "$file" "$w" "$h" "$first" "$count" |
    "${ff[@]}" -vf "extractplanes=y,format=gray16le,tmix=frames=$count,sobel=scale=0.125" \
      -f rawvideo -pix_fmt gray16le - | tail -c "$((w * h * 2))" >"$work/test.grad"
  [[ -s $work/raw.grad ]] || cp -- "$work/test.grad" "$work/raw.grad"
  ed=$(python3 "$CL_HELPER" edge "$w" "$h" "$work/raw.grad" "$work/test.grad" | cl_parse_kv edge)
  printf '%s %s %s %s\n' "$m" "$ed" "$(cl_parse_kv dark <<<"$sp")" "$(cl_parse_kv bright <<<"$sp")"
}

# cl_png FILE W H FRAME OUT [CROP]: one frame as PNG; CROP is WxH+X+Y, shown
# at 2x with square pixels.
cl_png() {
  local file=$1 w=$2 h=$3 frame=$4 out=$5 crop=${6:-} vf
  local -a ff
  local -
  set +o pipefail
  mapfile -t ff < <(cl_ffraw "$w" "$h")
  vf="scale=in_color_matrix=bt709:in_range=tv:out_range=pc,format=rgb24"
  if [[ $crop =~ ^([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+)$ ]]; then
    vf="crop=${BASH_REMATCH[1]}:${BASH_REMATCH[2]}:${BASH_REMATCH[3]}:${BASH_REMATCH[4]},scale=w=iw*2:h=ih*2:flags=neighbor:in_color_matrix=bt709:in_range=tv:out_range=pc,format=rgb24"
  fi
  cl_frames "$file" "$w" "$h" "$frame" 1 | "${ff[@]}" -vf "$vf" -frames:v 1 -y "$out"
}

# cl_fmt_row NAME NOISE_Y U V PSNR SSIM EDGE DARK BRIGHT FPS: one Markdown row.
cl_fmt_row() {
  awk -v n="$1" -v y="$2" -v u="$3" -v v="$4" -v p="$5" -v s="$6" -v e="$7" -v d="$8" -v b="$9" -v f="${10}" '
    function num(x, fmt) { return (x ~ /^-?[0-9.]+$/) ? sprintf(fmt, x) : "n/a" }
    function thou(x,   s, r) {
      if (x !~ /^[0-9]+$/) return "n/a"
      s = x ""; r = ""
      while (length(s) > 3) { r = "," substr(s, length(s) - 2) r; s = substr(s, 1, length(s) - 3) }
      return s r
    }
    BEGIN {
      printf "| %s | %s | %s / %s | %s | %s | %s | %s | %s | %s |\n", n, num(y, "%.2f"),
        num(u, "%.2f"), num(v, "%.2f"), num(p, "%.1f"), num(s, "%.3f"),
        (e ~ /^[0-9.]+$/) ? sprintf("%.1f%%", e * 100) : "n/a", thou(d), thou(b), f
    }'
}

cl_clip_usage() {
  cat <<'EOF'
camera-lab clip [options]: record one clip with the filter off, then render
every variant on the same frames and compare them (report.md, sheet.png).

  --frames N        frames to record (160)
  --size WxH        1920x1080 (default) or 1280x720
  --last N          frames measured, at the end of the clip (60)
  --presets LIST    post presets to render, comma separated; a+b stacks them
                    in one variant; `all` (default) or `none`
  --base cpu|raw    what the post presets run on: the filter's CPU temporal
                    output, as in live (cpu, default) or the raw frames
  --no-ane          skip the Neural Engine stage
  --crop WxH+X+Y    contact sheet region (default: the centre quarter)
  --from DIR        reuse DIR/raw.nv12 from an earlier run: no camera
  --out DIR         run directory (default ~/camera-lab/clip-<time>)
  --keep            keep every variant's NV12 file (big)
  --force           record even if another app is using the camera
EOF
}

cl_clip() {
  local frames=160 size=1920x1080 last=60 presets=all base=cpu ane=1 crop='' from='' out='' keep=0 force=0
  while (($#)); do
    case $1 in
      --frames) frames=$2; shift 2 ;;
      --size) size=$2; shift 2 ;;
      --last) last=$2; shift 2 ;;
      --presets) presets=$2; shift 2 ;;
      --base) base=$2; shift 2 ;;
      --no-ane) ane=0; shift ;;
      --crop) crop=$2; shift 2 ;;
      --from) from=$2; shift 2 ;;
      --out) out=$2; shift 2 ;;
      --keep) keep=1; shift ;;
      --force) force=1; shift ;;
      -h | --help) cl_clip_usage; return 0 ;;
      *) cl_clip_usage >&2; cl_die "clip: unknown option $1" ;;
    esac
  done
  [[ $size =~ ^([0-9]+)x([0-9]+)$ ]] || cl_die "--size takes WxH"
  local w=${BASH_REMATCH[1]} h=${BASH_REMATCH[2]}
  [[ $frames =~ ^[0-9]+$ && $last =~ ^[0-9]+$ ]] && ((last >= 2 && frames >= last)) ||
    cl_die "--frames must be at least --last, and --last at least 2"
  [[ $base == cpu || $base == raw ]] || cl_die "--base takes cpu or raw"
  for dep in ffmpeg python3; do command -v "$dep" >/dev/null || cl_die "$dep is missing"; done
  cl_load_default_presets

  local -a items=()
  case $presets in
    all) items=("${CL_PNAMES[@]}") ;;
    none) ;;
    *) IFS=, read -r -a items <<<"$presets" ;;
  esac
  local item
  for item in "${items[@]}"; do
    local -a parts
    IFS=+ read -r -a parts <<<"$item"
    cl_chains "${parts[@]}" >/dev/null || cl_die "clip: unknown preset in $item"
  done

  out=${out:-$CL_OUT/clip-$(date +%Y%m%d-%H%M%S)}
  mkdir -p -- "$out/frames" "$out/crops"
  local work=$out/work
  mkdir -p -- "$work"
  local fs=$((w * h * 3 / 2)) raw=$out/raw.nv12 readings journal conf_before

  if [[ -n $from ]]; then
    [[ -r $from/raw.nv12 ]] || cl_die "--from: no $from/raw.nv12"
    [[ $(readlink -f -- "$from/raw.nv12") == "$(readlink -f -- "$raw")" ]] || ln -sf -- "$(readlink -f -- "$from/raw.nv12")" "$raw"
    readings=$(sed -n 's/^Readings during the capture: //p' "$from/notes.txt" 2>/dev/null || true)
    journal=$(sed -n 's/^Filter log: //p' "$from/notes.txt" 2>/dev/null || true)
    conf_before=$(sed -n 's/^denoise.conf before: //p' "$from/notes.txt" 2>/dev/null || true)
    frames=$(($(stat -L -c %s -- "$raw") / fs))
    ((frames >= last)) || cl_die "--from: $raw holds $frames frames of ${w}x$h, fewer than --last"
  else
    for dep in gst-launch-1.0 pw-dump v4l2-ctl systemctl; do
      command -v "$dep" >/dev/null || cl_die "$dep is missing (camera-lab check)"
    done
    cl_require_nodes
    if [[ $CL_FILTER_STATE == running ]] && ((!force)); then
      cl_die "another app is using the camera; close it or pass --force"
    fi
    cl_start_session
    conf_before=$(cl_conf_summary)
    local since pid i
    since=$(date '+%Y-%m-%d %H:%M:%S')
    CL_SET[mode]=off
    cl_conf_apply
    for ((i = 0; i < 30; i++)); do
      cl_journal_lines "$since" 5 | grep -q 'mode off' && break
      sleep 0.1
    done
    sleep 0.5
    cl_say "camera-lab: recording $frames frames at ${w}x$h with mode = off"
    bash -c "timeout $((frames / 10 + 20)) $(cl_capture_cmd "$w" "$h" "$CL_FILTER_NAME" "$frames")" >"$raw" &
    pid=$!
    sleep 2.5
    readings=$(cl_readings)
    wait "$pid" || cl_say "camera-lab: the capture ended with an error"
    journal=$(cl_journal_lines "$since" 1)
    cl_restore_all
    cl_say "camera-lab: denoise.conf restored"
    local got=$(($(stat -c %s -- "$raw") / fs))
    ((got >= last)) || cl_die "recorded $got frames, fewer than --last $last"
    frames=$got
  fi

  {
    printf 'Clip: %sx%s NV12, %s frames, the last %s measured\n' "$w" "$h" "$frames" "$last"
    printf 'Recorded: %s\n' "$(date -r "$raw" '+%Y-%m-%d %H:%M:%S %z' 2>/dev/null || date)"
    printf 'Readings during the capture: %s\n' "${readings:-n/a}"
    printf 'Filter log: %s\n' "${journal:-n/a}"
    printf 'denoise.conf before: %s\n' "${conf_before:-n/a}"
  } >"$out/notes.txt"

  # Variants: name, file, render speed.
  local -a vname=() vfile=() vspeed=()
  vname+=("Raw camera (mode = off)"); vfile+=("$raw"); vspeed+=("-")
  local cpu=$work/cpu.nv12 bout notes=''
  if command -v aurora-camera-denoise-bench >/dev/null; then
    cl_say "camera-lab: the filter's CPU temporal stage, offline"
    if bout=$(aurora-camera-denoise-bench -b cpu -o "$cpu" "$w" "$h" "$raw" 2>&1); then
      vname+=("Filter: CPU temporal (the default)"); vfile+=("$cpu")
      vspeed+=("$(awk -v m="$(cl_parse_bench wall_ms_per_frame <<<"$bout")" 'BEGIN { printf "%.0f", 1000 / m }')")
      if ((ane)); then
        local s
        for s in 0.25 0.5 0.75 1.0; do
          cl_say "camera-lab: + the Neural Engine low-light stage at strength $s"
          if bout=$(aurora-camera-denoise-bench -b ane -s "$s" -o "$work/ane-$s.nv12" "$w" "$h" "$cpu" 2>&1); then
            vname+=("Filter: + low-light stage at $s$([[ $s == 1.0 ]] && echo ' (mode = on)')")
            vfile+=("$work/ane-$s.nv12")
            vspeed+=("$(awk -v m="$(cl_parse_bench wall_ms_per_frame <<<"$bout")" 'BEGIN { printf "%.0f", 1000 / m }')")
          else
            notes+="- The Neural Engine stage didn't run: $(tail -n 1 <<<"$bout")"$'\n'
            break
          fi
        done
      fi
    else
      notes+="- The filter's CPU stage didn't run: $(tail -n 1 <<<"$bout")"$'\n'
    fi
  else
    notes+="- aurora-camera-denoise-bench isn't installed: no filter variants."$'\n'
  fi
  local post_base=$raw post_label=raw
  if [[ $base == cpu && -s $cpu ]]; then post_base=$cpu post_label="CPU temporal"; fi
  [[ $base == cpu && ! -s $cpu ]] && notes+="- Post presets ran on the raw frames: no CPU filter output."$'\n'

  local -a ff
  mapfile -t ff < <(cl_ffraw "$w" "$h")
  local graph t0 t1 file safe
  for item in "${items[@]}"; do
    local -a parts
    IFS=+ read -r -a parts <<<"$item"
    graph=$(cl_render_graph "$w" "$h" "${parts[@]}")
    safe=${item//[^A-Za-z0-9._+-]/_}
    file=$work/post-$safe.nv12
    cl_say "camera-lab: post $item"
    t0=$(date +%s.%N)
    if "${ff[@]}" -vf "$graph" -f rawvideo -pix_fmt nv12 -y "$file" <"$post_base" 2>"$work/post-$safe.log" &&
      (($(stat -c %s -- "$file") == frames * fs)); then
      t1=$(date +%s.%N)
      vname+=("Post on $post_label: ${item//+/ + }"); vfile+=("$file")
      vspeed+=("$(awk -v n="$frames" -v a="$t0" -v b="$t1" 'BEGIN { printf "%.0f", n / (b - a) }')")
    else
      notes+="- Post $item failed: $(head -n 1 "$work/post-$safe.log")"$'\n'
    fi
  done

  # Measure, and a crop of the last frame per variant.
  local first=$((frames - last)) k row cx cy cw ch
  if [[ -z $crop ]]; then
    cw=$((w / 4 / 2 * 2)) ch=$((h / 4 / 2 * 2)) cx=$(((w - cw) / 2)) cy=$(((h - ch) / 2))
    crop=${cw}x$ch+$cx+$cy
  fi
  rm -f -- "$work/raw.grad"
  printf 'variant\tnoise_y\tnoise_u\tnoise_v\tpsnr_raw_mean\tssim\tedge\tdark\tbright\trender_fps\n' >"$out/metrics.tsv"
  local -a rows=() montage_args=()
  for k in "${!vname[@]}"; do
    cl_say "camera-lab: measuring ${vname[$k]}"
    row=$(cl_measure "$w" "$h" "$raw" "${vfile[$k]}" "$first" "$last" "$work")
    local -a m
    read -r -a m <<<"$row"
    printf '%s\t%s\t%s\n' "${vname[$k]}" "${row// /$'\t'}" "${vspeed[$k]}" >>"$out/metrics.tsv"
    rows+=("$(cl_fmt_row "${vname[$k]}" "${m[@]}" "${vspeed[$k]}")")
    printf -v safe '%02d' "$k"
    cl_png "${vfile[$k]}" "$w" "$h" $((frames - 1)) "$out/frames/$safe.png"
    cl_png "${vfile[$k]}" "$w" "$h" $((frames - 1)) "$out/crops/$safe.png" "$crop"
    montage_args+=(-label "$safe ${vname[$k]}" "$out/crops/$safe.png")
  done
  local sheet=''
  if command -v montage >/dev/null; then
    montage -background '#1e1e1e' -fill '#e0e0e0' -pointsize 18 "${montage_args[@]}" \
      -tile 4x -geometry +6+6 "$out/sheet.png" 2>"$work/montage.log" && sheet=sheet.png ||
      notes+="- The contact sheet failed: $(head -n 1 "$work/montage.log")"$'\n'
  else
    notes+="- ImageMagick's montage isn't installed: no contact sheet."$'\n'
  fi

  {
    printf '# Camera lab clip, %s\n\n' "$(date '+%Y-%m-%d %H:%M')"
    sed 's/^/- /' "$out/notes.txt"
    printf '%s\n\n' "- Contact sheet: ${sheet:-none}, crop $crop of the last frame at 2x; full frames in frames/."
    printf '| Variant | Luma noise | Chroma U / V | PSNR vs raw mean | SSIM | Edge contrast | Dark specks | Bright | Render fps |\n'
    printf '| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n'
    printf '%s\n' "${rows[@]}"
    printf '\nHow to read it (docs/camera-quality-research.md, section 7): luma noise is the\n'
    printf 'per-pixel standard deviation over the measured frames, mean over the frame\n'
    printf '(lower is cleaner; a static scene flatters temporal filters). Chroma is the same\n'
    printf 'for U and V. PSNR and SSIM are against the mean of all raw frames. Edge contrast\n'
    printf "is the mean Sobel gradient of the measured frames' average at the raw clip's\n"
    printf 'strongest 0.3%% edges, as a share of the raw clip'"'"'s (lower is blurrier). Specks\n'
    printf 'are pixels more than 24 below (dark) or above (bright) their 3x3 median, per\n'
    printf 'frame. Render fps is offline, on all cores (the filter rows: its own timing);\n'
    printf 'live needs 30. Size-changing presets are measured scaled back to the clip size.\n'
    [[ -z $notes ]] || printf '\nNotes:\n\n%s' "$notes"
  } >"$out/report.md"

  if ((!keep)); then
    rm -f -- "$work"/*.nv12 "$work"/*.grad
  fi
  cl_say "camera-lab: report in $out/report.md"
  printf '%s\n' "$out"
}

# --- virtual ------------------------------------------------------------------

# cl_loopback_dev: the first v4l2loopback device, if the module is loaded.
cl_loopback_dev() {
  local d
  [[ -d ${CAMERA_LAB_SYS_MODULE:-/sys/module}/v4l2loopback ]] || return 1
  for d in /sys/class/video4linux/video*; do
    [[ $(readlink -f "$d/device/driver" 2>/dev/null) == */v4l2loopback ||
      $(cat "$d/name" 2>/dev/null) == "Camera lab" ]] && { printf '/dev/%s' "${d##*/}"; return 0; }
  done
  return 1
}

cl_loopback_help() {
  cat <<'EOF'
No v4l2loopback device. To make one (needs sudo; Arch's extra repository):

  sudo pacman -S v4l2loopback-dkms
  sudo modprobe v4l2loopback exclusive_caps=1 card_label="Camera lab"

Then run `camera-lab virtual` again and pick "Camera lab" in Meet. To remove
it afterwards: sudo modprobe -r v4l2loopback
EOF
}

cl_virtual() {
  local size=1280x720 presets='' dev
  while (($#)); do
    case $1 in
      --size) size=$2; shift 2 ;;
      --presets) presets=$2; shift 2 ;;
      *) cl_die "virtual: unknown option $1" ;;
    esac
  done
  [[ $size =~ ^([0-9]+)x([0-9]+)$ ]] || cl_die "--size takes WxH"
  local w=${BASH_REMATCH[1]} h=${BASH_REMATCH[2]}
  dev=$(cl_loopback_dev) || { cl_loopback_help; return 3; }
  cl_load_default_presets
  local -a stack=()
  if [[ -n $presets ]]; then
    IFS=, read -r -a stack <<<"$presets"
  elif [[ -s $CL_STATE/stack ]]; then
    mapfile -t stack <"$CL_STATE/stack"
  fi
  local graph
  graph=$(cl_render_graph "$w" "$h" "${stack[@]}") || cl_die "virtual: unknown preset"
  graph=${graph%,format=nv12},format=yuv420p
  cl_require_nodes
  cl_say "camera-lab: ${w}x$h from $CL_FILTER_NAME through [ ${stack[*]:-no post filters} ] to $dev; Ctrl-C stops"
  local -a ff
  mapfile -t ff < <(cl_ffraw "$w" "$h")
  bash -c "$(cl_capture_cmd "$w" "$h" "$CL_FILTER_NAME")" |
    "${ff[@]}" -vf "$graph" -f v4l2 -pix_fmt yuv420p "$dev"
}

# --- status, check ------------------------------------------------------------

cl_status() {
  local key
  if cl_discover; then
    printf 'Filter node: %s (id %s, %s)\n' "$CL_FILTER_NAME" "$CL_FILTER_ID" "$CL_FILTER_STATE"
    printf 'Raw node:    %s (id %s)\n' "${CL_RAW_NAME:-not found}" "${CL_RAW_ID:--}"
  else
    printf 'Filter node: not found in PipeWire\n'
  fi
  printf 'denoise.conf: %s\n' "$CL_CONF"
  if [[ -e $CL_CONF ]]; then sed 's/^/  /' "$CL_CONF"; else printf '  (none: package defaults)\n'; fi
  if cl_has_backup; then
    printf 'Lab backup present: run `camera-lab restore` to put the original back\n'
  else
    printf 'Lab backup: none (the conf is the user'"'"'s own)\n'
  fi
  printf 'Effective: %s\n' "$(cl_effective_config)"
  printf 'Filter log:\n'
  cl_journal_lines '' 3 | sed 's/^/  /'
  printf 'V4L2:'
  for key in "${CL_V4L2_KEYS[@]}"; do printf ' %s=%s' "$key" "$(cl_v4l2_get "$key")"; done
  printf '%s\n' "$([[ -e $CL_STATE/v4l2.orig ]] && echo ' (lab backup present)')"
  printf 'Readings: %s\n' "$(cl_readings)"
  printf 'Effects: %s\n' "$(cl_effects_installed && echo installed || echo "not installed ($CL_EFFECTS_LIB)")"
  printf 'Saved post stack (for virtual): %s\n' "$( [[ -s $CL_STATE/stack ]] && paste -sd' ' "$CL_STATE/stack" || echo none)"
  if [[ -r $CL_STATE/preview.pid ]] && kill -0 "$(<"$CL_STATE/preview.pid")" 2>/dev/null; then
    printf 'Preview: running (pid %s)\n' "$(<"$CL_STATE/preview.pid")"
  fi
}

cl_restore_cmd() {
  CL_TOUCHED=0
  if ! cl_has_backup && [[ ! -e $CL_STATE/v4l2.orig ]]; then
    cl_preview_stop
    cl_say "camera-lab: nothing to restore: $CL_CONF is the user's own"
    return 0
  fi
  CL_EFFECTS_TOUCHED=$(cl_effects_installed && echo 1 || echo 0)
  cl_restore_all
}

cl_check() {
  local missing=0 dep el f name bad
  ok() { printf '  ok       %-28s %s\n' "$1" "${2:-}"; }
  miss() { printf '  MISSING  %-28s %s\n' "$1" "${2:-}"; missing=$((missing + 1)); }
  note() { printf '  note     %-28s %s\n' "$1" "${2:-}"; }
  printf 'Core\n'
  ((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 3))) && ok bash "$BASH_VERSION" || miss bash "4.3 or newer"
  for dep in python3 pw-dump pw-cli systemctl journalctl v4l2-ctl gst-launch-1.0 ffmpeg; do
    command -v "$dep" >/dev/null && ok "$dep" || miss "$dep"
  done
  if command -v gst-inspect-1.0 >/dev/null; then
    for el in pipewiresrc fdsink; do
      gst-inspect-1.0 "$el" >/dev/null 2>&1 && ok "gstreamer $el" || miss "gstreamer $el" "pipewire's GStreamer plugin / gstreamer core"
    done
  fi
  [[ -n ${XDG_RUNTIME_DIR:-} ]] && ok XDG_RUNTIME_DIR "$XDG_RUNTIME_DIR" ||
    miss XDG_RUNTIME_DIR "over SSH: export XDG_RUNTIME_DIR=/run/user/$(id -u)"
  command -v aurora-camera-denoise >/dev/null && ok aurora-camera-denoise "$(pacman -Q aurora-camera-denoise 2>/dev/null | cut -d' ' -f2)" ||
    miss aurora-camera-denoise "Aurora's package"
  systemctl --user is-active --quiet "$CL_SERVICE" 2>/dev/null && ok "$CL_SERVICE.service" active ||
    miss "$CL_SERVICE.service" "systemctl --user start $CL_SERVICE"
  [[ -e $CL_DEV ]] && ok "$CL_DEV" "$(v4l2-ctl -d "$CL_DEV" --info 2>/dev/null | sed -n 's/^\s*Driver name\s*: //p')" || miss "$CL_DEV"
  cl_iio_dir >/dev/null && ok "light sensor" "$(cl_iio_dir)" || note "light sensor" "not found: no lux in notes"
  if cl_discover 2>/dev/null; then
    ok "raw node" "${CL_RAW_NAME:-not found} (id ${CL_RAW_ID:--})"
    ok "filter node" "$CL_FILTER_NAME (id $CL_FILTER_ID, $CL_FILTER_STATE)"
  else
    miss "filter node" "no aurora_camera_denoise.* Video/Source in pw-dump"
  fi
  cl_has_backup && note "lab backup" "present: run camera-lab restore" || ok "lab backup" "none (the conf is the user's own)"
  printf 'live\n'
  for dep in mpv gum; do command -v "$dep" >/dev/null && ok "$dep" || miss "$dep"; done
  [[ -n ${WAYLAND_DISPLAY:-}${DISPLAY:-} ]] && ok display "${WAYLAND_DISPLAY:-$DISPLAY}" ||
    note display "none in this shell: live needs WAYLAND_DISPLAY (ls \$XDG_RUNTIME_DIR/wayland-*)"
  command -v socat >/dev/null && ok socat "(not needed: the helper talks to mpv)" || note socat "not needed"
  printf 'clip\n'
  for dep in aurora-camera-denoise-bench aurora-camera-denoise-metrics montage; do
    command -v "$dep" >/dev/null && ok "$dep" || miss "$dep"
  done
  printf 'effects and virtual\n'
  cl_effects_installed && ok effects "$CL_EFFECTS_LIB" || note effects "not installed ($CL_EFFECTS_LIB)"
  cl_loopback_dev >/dev/null && ok v4l2loopback "$(cl_loopback_dev)" || note v4l2loopback "not loaded: camera-lab virtual prints how"
  printf 'Presets\n'
  cl_load_default_presets
  local filters=''
  command -v ffmpeg >/dev/null && filters=$(ffmpeg -hide_banner -filters 2>/dev/null | awk 'NF >= 3 { print $2 }')
  for name in "${CL_PNAMES[@]}"; do
    bad=''
    for f in $(cl_filters_in "${CL_PCHAIN[$name]}"); do
      grep -qx -- "$f" <<<"$filters" || bad+=" $f"
    done
    if [[ -n $bad ]]; then
      miss "preset $name" "FFmpeg lacks:$bad"
    elif command -v ffmpeg >/dev/null && ! ffmpeg -v error -nostdin -f lavfi -i "color=gray:s=64x36:r=30:d=0.2" \
      -vf "$(cl_render_graph 64 36 "$name")" -f null - 2>/dev/null; then
      miss "preset $name" "doesn't run: ${CL_PCHAIN[$name]}"
    else
      ok "preset $name"
    fi
  done
  if ((missing)); then
    printf '%s missing\n' "$missing"
    return 1
  fi
  printf 'All there.\n'
}

cl_usage() {
  sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//'
}

cl_main() {
  local cmd=${1:-help}
  shift || true
  case $cmd in
    live) cl_live "$@" ;;
    clip) cl_clip "$@" ;;
    virtual) cl_virtual "$@" ;;
    status) cl_status ;;
    restore) cl_restore_cmd ;;
    check) cl_check ;;
    help | -h | --help) cl_usage ;;
    *) cl_usage >&2; exit 2 ;;
  esac
}

[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0
cl_main "$@"
