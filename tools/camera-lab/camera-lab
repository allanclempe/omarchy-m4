cl_menu_value() { # KEY CHOICES HELP CURRENT
  local key=$1 choices=$2 help=$3 cur=$4 pick
  local -a opts=("(default: leave the key out)") more=()
  read -r -a more <<<"$choices"
  opts+=("${more[@]}" "other value...")
  pick=$(cl_choose --header "$key = ${cur:-default}   ($help)" "${opts[@]}") || return 1
  case $pick in
    "(default"*) printf '' ;;
    "other value...") gum input --header "$key =" --value "$cur" || return 1 ;;
    *) printf '%s' "$pick" ;;
