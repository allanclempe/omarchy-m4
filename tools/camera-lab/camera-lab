}

cl_menu_camera() {
  local pick key val label
  while true; do
    local -A map=()
    local -a items=()
    for key in "${CL_CONF_KEYS[@]}"; do
      label=$(printf '%-22s %-8s %s' "$key" "${CL_SET[$key]:-default}" "${CL_CONF_HELP[$key]}")
      items+=("$label"); map[$label]=conf:$key
    done
    for key in "${CL_V4L2_KEYS[@]}"; do
      label=$(printf '%-22s %-8s %s' "$key" "$(cl_v4l2_get "$key")" "${CL_V4L2_HELP[$key]}")
      items+=("$label"); map[$label]=v4l2:$key
    done
    for label in "Set: your own settings (as before the lab)" "Set: package defaults (empty [denoise])" \
      "Set: raw camera (mode = off)" "Set: low-light stage always (mode = on)" \
      "Set: research dim-light levels (enter-gain 2304, exit-gain 1792, enter-noise 0)" \
      "Resolution: $( ((CL_W == 1920)) && echo "switch to 1280x720 (no Neural Engine stage)" || echo "switch to 1920x1080")" \
      "Back"; do
      items+=("$label"); map[$label]=$label
    done
    clear
    cl_status_block
    pick=$(cl_choose --header "Camera (layer 1): what every app sees. Changes reload the filter." "${items[@]}") || return 0
    case ${map[$pick]:-Back} in
      Back) return 0 ;;
      conf:*)
        key=${map[$pick]#conf:}
        val=$(cl_menu_value "$key" "${CL_CONF_CHOICES[$key]}" "${CL_CONF_HELP[$key]}" "${CL_SET[$key]:-}") || continue
        if [[ -z $val ]]; then unset "CL_SET[$key]"; else CL_SET[$key]=$val; fi
        cl_conf_apply
        ;;
      v4l2:*)
        key=${map[$pick]#v4l2:}
        val=$(cl_choose --header "$key  (${CL_V4L2_HELP[$key]})" ${CL_V4L2_CHOICES[$key]}) || continue
        cl_v4l2_set "$key" "$val" >/dev/null
        ;;
      "Set: your own"*) cl_conf_original; cl_conf_apply ;;
      "Set: package defaults"*) CL_SET=(); CL_SET_EXTRA=(); cl_conf_apply ;;
      "Set: raw camera"*) CL_SET[mode]=off; cl_conf_apply ;;
      "Set: low-light stage always"*) CL_SET[mode]=on; cl_conf_apply ;;
      "Set: research dim-light"*)
        CL_SET[mode]=auto CL_SET[enter-gain]=2304 CL_SET[exit-gain]=1792 CL_SET[enter-noise]=0
        cl_conf_apply
        ;;
      Resolution:*)
        if ((CL_W == 1920)); then CL_W=1280 CL_H=720; else CL_W=1920 CL_H=1080; fi
        cl_drop_slow_presets
        cl_preview_stop
        cl_preview_start || true
        ;;
    esac
    sleep 0.5
    # The stream survives a reload (checked on the J616c); restart it if not.
    if ! cl_preview_alive; then
      cl_say "camera-lab: the preview stopped; restarting it"
      cl_preview_start || true
    fi
  done
}

# A slow preset can't keep 30 fps at 1920x1080: drop it from the live stack.
cl_drop_slow_presets() {
  local name
  local -a keep=()
  ((CL_W > 1280)) || return 0
  for name in "${CL_STACK[@]}"; do
    if cl_has_flag "$name" slow; then
      cl_say "camera-lab: $name is too slow at ${CL_W}x$CL_H; removed from the stack"
    else
      keep+=("$name")
    fi
  done
  CL_STACK=("${keep[@]}")
}

cl_stack_has() { local n; for n in "${CL_STACK[@]}"; do [[ $n == "$1" ]] && return 0; done; return 1; }

cl_stack_toggle() {
  local name=$1 n
  local -a keep=()
  if cl_stack_has "$name"; then
    for n in "${CL_STACK[@]}"; do [[ $n == "$name" ]] || keep+=("$n"); done
    CL_STACK=("${keep[@]}")
  else
    CL_STACK+=("$name")
  fi
}

cl_menu_post() {
  local pick name label pos i toggled
  while true; do
    toggled=''
    local -A map=()
    local -a items=()
    for name in "${CL_PNAMES[@]}"; do
      pos=' '
      for i in "${!CL_STACK[@]}"; do [[ ${CL_STACK[$i]} == "$name" ]] && pos=$((i + 1)); done
      label=$(printf '[%s] %-16s %s' "$pos" "$name" "${CL_PNOTE[$name]}")
      if cl_has_flag "$name" slow && ((CL_W > 1280)); then label+="  (slow: 1280x720 or clip only)"; fi
      items+=("$label"); map[$label]=$name
    done
    items+=("Move a filter earlier" "Clear the stack" "Back")
    clear
    cl_status_block
    pick=$(cl_choose --header "Post filters (layer 2, preview only): pick to add at the end or remove. [n] = position" "${items[@]}") || return 0
    case $pick in
      Back) return 0 ;;
      "Clear the stack") CL_STACK=() ;;
      "Move a filter earlier")
        ((${#CL_STACK[@]} > 1)) || continue
        name=$(cl_choose --header "Move which one earlier?" "${CL_STACK[@]:1}") || continue
        for i in "${!CL_STACK[@]}"; do
          if [[ ${CL_STACK[$i]} == "$name" ]] && ((i > 0)); then
            CL_STACK[i]=${CL_STACK[i - 1]}
            CL_STACK[i - 1]=$name
            break
          fi
        done
        ;;
      *)
        name=${map[$pick]}
        if cl_has_flag "$name" slow && ((CL_W > 1280)) && ! cl_stack_has "$name"; then
          gum style --foreground 214 "$name is too slow for 30 fps at ${CL_W}x$CL_H: switch to 1280x720 (Camera menu) or try it in clip mode."
          sleep 2
          continue
        fi
        cl_stack_toggle "$name"
        toggled=$name
        ;;
    esac
    if ! cl_apply_view && [[ -n $toggled ]]; then
      cl_stack_toggle "$toggled"
      cl_apply_view || true
      sleep 3
    fi
  done
}

cl_menu_effects() {
  local pick path
  if ! cl_effects_installed; then
    gum style --border rounded --padding "0 1" \
      "Effects aren't installed: background blur and replace, and face framing, need" \
      "$CL_EFFECTS_LIB" \
      "from Aurora's omarchy-ane companion (examples/camera-effects). Nothing to toggle." \
