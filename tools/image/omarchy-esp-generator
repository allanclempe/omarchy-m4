#!/bin/sh
# omarchy-esp-generator: mount /boot/efi from the ESP this Mac booted from.
#
# A systemd generator (systemd.generator(7)), installed in the J616c image at
# /usr/local/lib/systemd/system-generators/. Every Omarchy image mounts its
# ESP by the same FAT serial (UUID=4F4D-5801 in fstab), so on a Mac with a
# second Omarchy ESP, such as one left by an earlier install, Linux can mount
# the wrong one and boot updates land where the Mac never reads them
# (omarchy-m4 OMS-12, JOURNEY 9.11). aura names the ESP it booted from in the
# device tree, as omarchy-mac-esp reads it. This writes boot-efi.mount for that
# partition into the early generator directory, which takes precedence over
# the unit systemd-fstab-generator makes from fstab. Without that name, it
# writes nothing and fstab's entry applies as before.
#
#   omarchy-esp-generator NORMAL_DIR EARLY_DIR LATE_DIR
#
# Tests run it as a normal user, with OMARCHY_ESP_PARTUUID_FILE naming the
# device-tree property to read; root always reads the live one.
set -eu

early=${2:?usage: omarchy-esp-generator NORMAL_DIR EARLY_DIR LATE_DIR}
node=/proc/device-tree/chosen/asahi,efi-system-partition
[ "$(id -u)" -eq 0 ] || node=${OMARCHY_ESP_PARTUUID_FILE:-$node}

[ -r "$node" ] || exit 0
uuid=$(tr -d '\0' <"$node" | tr 'ABCDEF' 'abcdef')
case $uuid in
  [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
  *) exit 0 ;;
esac

device=/dev/disk/by-partuuid/$uuid
# fstab checks the ESP at boot (pass 2): keep that check for this device.
fsck=$(/usr/bin/systemd-escape --path "$device")

mkdir -p "$early/local-fs.target.requires"
cat >"$early/boot-efi.mount" <<EOF
# Automatically generated by omarchy-esp-generator: the ESP this Mac booted
# from (/proc/device-tree/chosen/asahi,efi-system-partition), in place of
# fstab's shared UUID=4F4D-5801.
[Unit]
Description=EFI System Partition this Mac booted from
Documentation=man:systemd.generator(7)
Before=local-fs.target
Requires=systemd-fsck@$fsck.service
After=systemd-fsck@$fsck.service

[Mount]
What=$device
Where=/boot/efi
Type=vfat
Options=umask=0077
EOF
ln -sf ../boot-efi.mount "$early/local-fs.target.requires/boot-efi.mount"
