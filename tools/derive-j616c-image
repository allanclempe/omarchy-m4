#!/bin/bash
# Derive a developer-only J616c (MacBook Pro 16-inch, M4 Max) Omarchy payload
# from an edge payload built by omarchy-mac-installer's image-builder, for a
# stub on macOS 27.2 (26B123) firmware (OMS-30; docs/oms-30-image-plan.md).
#
# Local developer tooling, not a release producer. The platform is omacom's
# edge stack, [omarchy] first, as the image-builder writes it: Aurora's own
# repository is not used, since its kernel lacks the 27.2 support. It:
#   - installs and pins the exact [omarchy] edge builds it was made with
#     (EDGE_PINS) and stops if the repo has moved on: the Mesa the kernel
#     requires; the boot scripts (aurora-scripts, omarchy-mac-boot); Touch ID
#     (omarchy-mac with the J616c's xART guard, libfprint-git); audio
#     (aurora-audio with the J616 graphs and speaker profile,
#     alsa-ucm-conf-aurora, speakersafetyd); the VA-API bridge with the aurora
#     alias (OMS-4); the titlebars plugin built for edge's Hyprland;
#   - installs three patched builds from the PKGS input, each pinned by sha256,
#     and holds them in pacman.conf's IgnorePkg (HOLDS) so omarchy update keeps
#     them: linux-aurora 7.3.0.aurora1-1.1 (edge's, omacom/linux-aurora
#     3058cc5c, which carries aurora-silicon/linux#1954 and #2233, plus
#     patches/linux-t6041-26b123-32core.patch, without which the 32-core
#     J616c's GPU never starts on 27.2; all three checked in its modules);
#     aquamarine 0.16.0-1.4 (edge's 1.2 plus omarchy-pkgs#2739's alpha-variant
#     scanout fallback: on firmware 27 the T6041 primary plane offers no
#     XRGB8888, and stock aquamarine makes Hyprland crash-loop); and hyprland
#     0.57.2-9.2 (edge's 9 plus patches/hyprland-alpha-variant-buffer-present.patch,
#     omarchy-pkgs#3854, without which the fallback repeats stale frames);
#   - runs owner setup's kmscon with --no-drm, which then draws through the
#     kernel's AR24 framebuffer: its DRM backend asks for XRGB8888 and draws
#     nothing on that plane (omacom/omarchy#20512 does the same on Snapdragon);
#   - starts speakersafetyd for the J616 speaker card, which speakersafetyd's
#     own rule doesn't list (tools/image/96-speakersafetyd-j616.rules, OMS-1);
#   - installs linux-firmware-realtek from [core]: the image ships no linux-firmware
#     split, so USB-C Ethernet dongles on RTL8153B (and Realtek USB Wi-Fi and
#     Bluetooth) ran without their firmware (OMS-7);
#   - lets x86-64 containers run (OMS-41): installs qemu-user-static and
#     qemu-user-static-binfmt built from omacom/omarchy-pkgs#3505, #3602 and
#     #3603 merged (QEMU 11.1.3 with three linux-user patches) over the image's
#     Debian build, Aurora's aurora-userpages for the userpages command and its
#     user4k=on GRUB drop-in, and runs containerd under userpages 4k
#     (tools/image/containerd-user4k.conf), since x86 libraries built for 4 KiB
#     pages don't map on the 16 KiB kernel. Those three packages come from the
#     PKGS input too;
#   - uses Stage 1 and Stage 2 built from aura v1.0.0b17 (STAGE1_COMMIT), which
#     carry aura#265 (27.2 GPU and display hand-off on T6041) and the later M4
#     27.2 fixes; edge's aura package predates #265. Stage 2 is installed at
#     /usr/local/lib/aura and named by M1N1= in /etc/default/update-m1n1, so
#     every later kernel or U-Boot update rebuilds boot.bin and, through
#     omarchy-mac-boot's omarchy-mac-boot-ctxr hook, m1n1/boot-ctxr.bin with it.
#     omarchy-mac-boot's boot check accepts only a package-owned Stage 2, so the
#     image ships /etc/omarchy-mac-boot/owner-boot-chain while the pin stands;
#   - installs omarchy-esp-generator (tools/image), which mounts /boot/efi from
#     the ESP aura names in the device tree rather than fstab's UUID=4F4D-5801,
#     which every Omarchy ESP shares (OMS-12), and /boot from the partition
#     after it rather than the Boot UUID every install shares (OMS-15);
#   - lets the image's own hooks rebuild the UKI, then builds Stage 2 with the
#     stock update-m1n1, and replaces the edge image's esp/aurora/stage1.macho
#     with aura v1.0.0b17's Mach-O Stage 1. The J616c takes upstream's macho
#     mode like every M4 Mac: Recovery pads it for the execute window and
#     enrolls it with kmutil --compress. On 27.2, kmutil wraps a raw Stage 1 as
#     an unpadded Mach-O object that arms no window for the OS (JOURNEY 9.59);
#   - re-seals @factory and packages the payload with its installer_data.json.
#
# Run on an aarch64 Linux host with Docker and passwordless sudo:
#   derive-j616c-image EDGE_OUT_DIR ROOTFS_TARBALL STAGE1 STAGE2 PKGS OUTPUT_DIR
# STAGE1 is aura's Mach-O Stage 1, unpadded: build/aura.bin from aura
# STAGE1_COMMIT with the aura PKGBUILD's Stage 1 flags (RELEASE=1 CHAINLOADING=1
# USE_CLANG=1 BUILTIN_LOGO=aurora), wrapped by aura's own
# `tools/macho_boot_object.py build/aura.bin OUT` (no --execute-window: Recovery
# pads it). STAGE2 is aura's Stage 2 from the same commit (the same flags plus
# ESP_STAGE2=1). Their sha256 must be STAGE1_SHA256 and STAGE2_SHA256.
# PKGS is a directory holding every file PKG_SHA256 names: the two packages
# omarchy-pkgs builds at QEMU_PR_COMMIT (`bin/build --arch aarch64 --package
# qemu-user-static`), Aurora's aurora-userpages, and the three patched builds.
# EDGE_OUT_DIR is built with the image-builder from the patched installer
# (patches/j616c-installer.patch), so its Recovery app is that tree's.
set -euo pipefail

# The exact [omarchy] edge builds this image is made and tested with. The repo
# keeps only its latest build, so a pin can't fetch an older one: it stops the
# build when the repo has moved on, so a new kernel or Mesa never ships
# untested. Bump these on purpose, and record why in JOURNEY.
declare -A EDGE_PINS=(
  [mesa-aurora]=1:26.3.0_devel.20261127.234134.a6853addcd0-1
  [vulkan-aurora]=1:26.3.0_devel.20261127.234134.a6853addcd0-1
  [aura]=1.0.0b13.r20261118-1
  [uboot-aurora]=2026.07.aurora9-1
  [aurora-scripts]=20261023-2
  [omarchy-mac-boot]=20261123-1
  [omarchy-mac]=0.2.8-1
  [libfprint-git]=1:1.94.100.r10.g6f9479c-6
  [aurora-audio]=4.1.aurora3-6
  [alsa-ucm-conf-aurora]=10.aurora3-2
  [speakersafetyd]=3.0.0-1
  [libva-v4l2_request-avd]=1.3.r11.r169.gc653eaa-2
  [omarchy-hyprland-titlebars]=0.4.0-6
)
# The patched builds from PKGS, and the versions they must install as. Held in
# IgnorePkg (with hyprpm, Hyprland's split package, and the titlebars plugin
# built for this Hyprland), so omarchy update keeps them until edge carries
# the fixes; drop each hold with its package.
declare -A PATCHED=(
  [linux-aurora]=7.3.0.aurora1-1.1
  [aquamarine]=0.16.0-1.4
  [hyprland]=0.57.2-9.2
)
HOLDS="linux-aurora aquamarine hyprland hyprpm omarchy-hyprland-titlebars"
# Realtek firmware for USB-C dongles: the r8152 Ethernet family (RTL8153B wants
# rtl_nic/rtl8153b-2.fw), Realtek USB Wi-Fi and Bluetooth. The image ships no
# linux-firmware split, since the Mac's own firmware comes from macOS (OMS-7).
DONGLE_FIRMWARE=(core/linux-firmware-realtek)
# Stage 1 and Stage 2 from aura v1.0.0b17, built on the Mac (JOURNEY 9.58):
# Stage 2 3,997,696 B. Stage 1 is the Mach-O object wrapped from that build's
# aura-raw.bin (sha256 93457a37…40be); record its sha256 after wrapping it.
STAGE1_COMMIT=5a244b5bcbaf
STAGE1_SHA256=
STAGE2_SHA256=aef08d291be788366fd4bb53790f0f00ddebcfe86c470f90d953c46957cfa985
STAGE2_PATH=/usr/local/lib/aura/m1n1-$STAGE1_COMMIT.bin
# qemu-user-static from omacom/omarchy-pkgs#3505 (source build and 1002), #3602
# (1000) and #3603 (1001), merged on allanclempe/omarchy-pkgs branch
# oms-41/qemu-user-static-image and tested on the Mac with SQL Server 2022 and
# node:22 (OMS-41, JOURNEY 9.56). Drop them once omarchy's repo publishes all
# three. aurora-userpages is Aurora's build; it depends on glibc alone.
QEMU_PR_COMMIT=10cb1547eabd
QEMU_VERSION=1:11.1.3-1
declare -A PKG_SHA256=(
  [qemu-user-static-$QEMU_VERSION-aarch64.pkg.tar.zst]=544e83b4586d99a56a5875b0de1e559750a14ab49d7056bc01a03daa94456fca
  [qemu-user-static-binfmt-$QEMU_VERSION-aarch64.pkg.tar.zst]=693bd474721d3c1edc9b96e8677081c4081a932ee925cb3136c5884a8768ab43
  [aurora-userpages-7.3.0.aurora1-41-aarch64.pkg.tar.xz]=4188aeac66a586b210d97e5b35a2edf0ab250939d1221b59bef296db69cd5f68
  # JOURNEY 9.60: omarchy-pkgs' linux-aurora PKGBUILD with the GPU patch, pkgrel 1.1.
  [linux-aurora-7.3.0.aurora1-1.1-aarch64.pkg.tar.zst]=005928fe711a8f0d06ef97093a2c253ca4fbabe092194491a60aaccf1823b954
  # JOURNEY 9.64: built natively on the J616c from the edge recipes plus the patches.
  [aquamarine-0.16.0-1.4-aarch64.pkg.tar.xz]=5d52ab0ce1aa42e3210163885e2f32017e0c164a55cad6fe3d862db3d6dd237b
  [hyprland-0.57.2-9.2-aarch64.pkg.tar.xz]=bf3b315315da783e3f6fccab0e348ae7e593c4cf0a1a2501426a9ed504beab64
)
QEMU_BINFMT=qemu-x86_64-static.conf

log() { printf '[%4ss] %s\n' "$SECONDS" "$*"; }
fail() { printf 'derive-j616c-image: %s\n' "$*" >&2; exit 1; }

host() {
  local edge=$1 rootfs=$2 stage1=$3 stage2=$4 pkgs=$5 out=$6 image file
  [[ -d $edge && -f $rootfs && -f $stage1 && -f $stage2 && -d $pkgs ]] ||
    fail "usage: $0 EDGE_OUT ROOTFS STAGE1 STAGE2 PKGS OUT"
  [[ -n $STAGE1_SHA256 && -n $STAGE2_SHA256 ]] ||
    fail "record the sha256 of Stage 1 and Stage 2 built from aura $STAGE1_COMMIT in STAGE1_SHA256 and STAGE2_SHA256 first"
  [[ $(sha256sum "$stage1" | cut -d' ' -f1) == "$STAGE1_SHA256" ]] || fail "$stage1 is not the pinned aura $STAGE1_COMMIT Stage 1"
  [[ $(sha256sum "$stage2" | cut -d' ' -f1) == "$STAGE2_SHA256" ]] || fail "$stage2 is not the pinned aura $STAGE1_COMMIT Stage 2"
  for file in "${!PKG_SHA256[@]}"; do
    [[ -f $pkgs/$file ]] || fail "$pkgs has no $file"
    [[ $(sha256sum "$pkgs/$file" | cut -d' ' -f1) == "${PKG_SHA256[$file]}" ]] ||
      fail "$pkgs/$file is not the pinned build"
  done
  mkdir -p "$out"
  [[ -z $(ls -A "$out") ]] || fail "$out is not empty"
  image=omarchy-j616c-derive:$(sha256sum "$rootfs" | cut -c1-16)
  if ! sudo docker image inspect "$image" >/dev/null 2>&1; then
    sudo docker import --platform linux/arm64 "$rootfs" "$image" >/dev/null
  fi
  sudo docker run --rm --privileged --platform linux/arm64 \
    -v "$(cd "$(dirname "$0")" && pwd):/tools:ro" -v "$(cd "$edge" && pwd):/edge:ro" \
    -v "$(cd "$out" && pwd):/out" -v /work \
    -v "$(cd "$(dirname "$stage1")" && pwd)/$(basename "$stage1"):/stage1.macho:ro" \
    -v "$(cd "$(dirname "$stage2")" && pwd)/$(basename "$stage2"):/stage2.bin:ro" \
    -v "$(cd "$pkgs" && pwd):/pkgs:ro" \
    "$image" /bin/bash /tools/derive-j616c-image --in-container
}

mounts=()
loops=()
cleanup() {
  local rc=$? i
  # The work volume goes with the container: on a failure, keep its logs.
  if ((rc != 0)) && [[ -d /out && -n ${W:-} ]]; then
    mkdir -p /out/failed-logs && cp -p "$W"/*.log "$W"/*.txt /out/failed-logs/ 2>/dev/null || true
  fi
  for ((i = ${#mounts[@]} - 1; i >= 0; i--)); do umount "${mounts[i]}" 2>/dev/null || umount -l "${mounts[i]}" 2>/dev/null || true; done
  for i in "${loops[@]}"; do losetup -d "$i" 2>/dev/null || true; done
}

mnt() {  # mnt TARGET mount-args...
  local target=$1
  shift
  mkdir -p "$target"
  mount "$@" "$target" || fail "could not mount $target"
  mounts+=("$target")
}

loop() {  # loop VAR FILE: attach FILE and name its device in VAR. Not in a
  # subshell, so cleanup sees every device it attached.
  local device
  device=$(losetup -f --show "$2") || fail "no loop device for $2"
  loops+=("$device")
  printf -v "$1" %s "$device"
}

in_chroot() { chroot "$T" /usr/bin/env -i PATH=/usr/bin:/usr/sbin HOME=/root LC_ALL=C "$@"; }

# module_has RELEASE MODULE STRING: the kernel module (plain or compressed) contains STRING.
module_has() {
  local file
  file=$(ls "$T/usr/lib/modules/$1/kernel/$2".ko* 2>/dev/null | head -1)
  [[ -n $file ]] || return 1
  case $file in
    *.zst) zstd -dcq "$file" ;;
    *.xz) xz -dc "$file" ;;
    *.gz) gzip -dc "$file" ;;
    *) cat "$file" ;;
  esac | grep -aqF -- "$3"
}

container() {
  trap cleanup EXIT
  W=/work T=/work/target
  cd "$W"
  log "toolchain"
  pacman-key --init >/dev/null 2>&1
  pacman-key --populate archlinuxarm >/dev/null 2>&1
  pacman -Sy --noconfirm --needed btrfs-progs dosfstools e2fsprogs libarchive gnupg python zstd xz >/work/toolchain.log 2>&1 ||
    fail "could not install the toolchain"

  local zip data name
  zip=$(ls /edge/*-os-package.zip)
  [[ $(wc -l <<<"$zip") == 1 ]] || fail "expected one payload in /edge"
  data=/edge/installer_data.json
  log "unpacking $(basename "$zip")"
  mkdir -p "$W/payload"
  bsdtar -xf "$zip" -C "$W/payload"
  [[ -f $W/payload/root.img && -f $W/payload/boot.img && -d $W/payload/esp ]] || fail "unexpected payload layout"

  log "mounting the image"
  truncate -s 524288000 "$W/esp.img"
  mkfs.vfat -F 32 -n OMARCHYESP -i 4f4d5801 "$W/esp.img" >/dev/null
  local root_loop boot_loop esp_loop
  loop root_loop "$W/payload/root.img"
  loop boot_loop "$W/payload/boot.img"
  loop esp_loop "$W/esp.img"
  mnt "$W/top" -o subvolid=5 "$root_loop"
  mnt "$T" -o subvol=@,compress=zstd "$root_loop"
  mnt "$T/home" -o subvol=@home,compress=zstd "$root_loop"
  mnt "$T/var/log" -o subvol=@log,compress=zstd "$root_loop"
  mnt "$T/var/cache/pacman/pkg" -o subvol=@pkg,compress=zstd "$root_loop"
  mnt "$T/boot" "$boot_loop"
  mnt "$T/boot/efi" "$esp_loop"
  cp -a "$W/payload/esp/." "$T/boot/efi/"
  # asahi-scripts keep update-m1n1 on a builder's ESP when this marker is there.
  : >"$T/boot/efi/.builder"

  # The image's platform, as image-builder presents it: a Mac's device tree
  # and the UEFI U-Boot gives, with no EFI variables.
  mnt "$T/proc" -t proc proc
  mnt "$T/sys" -t sysfs -o ro sysfs
  mnt "$T/sys/firmware" -t tmpfs -o mode=0755,size=1m tmpfs
  mkdir -p "$T/sys/firmware/devicetree/base" "$T/sys/firmware/efi/efivars"
  printf '%s\0' apple,arm-platform >"$T/sys/firmware/devicetree/base/compatible"
  printf 'Omarchy image (apple-silicon)\0' >"$T/sys/firmware/devicetree/base/model"
  mnt "$T/dev" --rbind /dev
  mnt "$T/run" -t tmpfs -o mode=0755 tmpfs
  mkdir -p "$T/run/lock"
  mnt "$T/tmp" -t tmpfs -o mode=1777 tmpfs
  cp -L /etc/resolv.conf "$T/run/resolv.conf"
  local resolv_backup=""
  if [[ -e $T/etc/resolv.conf || -L $T/etc/resolv.conf ]]; then
    resolv_backup=$W/resolv.conf.image
    cp -a "$T/etc/resolv.conf" "$resolv_backup"
    rm -f "$T/etc/resolv.conf"
  fi
  cp -L /etc/resolv.conf "$T/etc/resolv.conf"

  log "temporary keyring"
  [[ ! -e $T/etc/pacman.d/gnupg ]] || fail "the image already has a pacman keyring"
  in_chroot pacman-key --init >"$W/keyring.log" 2>&1
  in_chroot pacman-key --populate >>"$W/keyring.log" 2>&1

  log "pacman.conf: [omarchy] first, no [aurora]"
  local first
  first=$(grep -E '^\[[^]]+\]' "$T/etc/pacman.conf" | grep -vx '\[options\]' | head -1)
  [[ $first == "[omarchy]" ]] || fail "pacman.conf's first repository is $first, not [omarchy]; build the edge payload with the image-builder that puts [omarchy] first (omarchy-mac-installer#224)"
  ! grep -qx '\[aurora\]' "$T/etc/pacman.conf" || fail "pacman.conf has [aurora]; this image takes its platform from [omarchy] edge"

  log "installing the pinned edge builds"
  in_chroot pacman -Sy --noconfirm >"$W/pacman.log" 2>&1 || fail "pacman -Sy failed (pacman.log)"
  # Before installing anything: the repo must still offer exactly the pinned builds.
  local pkg have moved=() wanted=()
  for pkg in "${!EDGE_PINS[@]}"; do
    have=$(in_chroot pacman -Si "omarchy/$pkg" 2>/dev/null | sed -n 's/^Version *: //p')
    [[ $have == "${EDGE_PINS[$pkg]}" ]] || moved+=("$pkg: pinned ${EDGE_PINS[$pkg]}, [omarchy] has ${have:-nothing}")
    wanted+=("omarchy/$pkg")
  done
  ((${#moved[@]} == 0)) ||
    fail "[omarchy] no longer offers the pinned builds; review them, then bump EDGE_PINS: $(printf '%s; ' "${moved[@]}")"
  in_chroot pacman -S --noconfirm --needed "${wanted[@]}" >>"$W/pacman.log" 2>&1 ||
    fail "could not install the pinned edge builds (pacman.log)"

  log "installing the PKGS input: the patched kernel, aquamarine and Hyprland, QEMU and userpages"
  in_chroot pacman -Qq qemu-user-static-binfmt >/dev/null 2>&1 ||
    fail "the image has no qemu-user-static-binfmt to replace; recheck OMS-41"
  install -d "$T/tmp/pkgs"
  local file files=()
  for file in "${!PKG_SHA256[@]}"; do
    cp "/pkgs/$file" "$T/tmp/pkgs/"
    files+=("/tmp/pkgs/$file")
  done
  in_chroot pacman -U --noconfirm "${files[@]}" >>"$W/pacman.log" 2>&1 ||
    fail "could not install the PKGS input (pacman.log)"
  rm -rf "$T/tmp/pkgs"
  for pkg in "${!PATCHED[@]}"; do
    [[ $(in_chroot pacman -Q "$pkg" 2>/dev/null) == "$pkg ${PATCHED[$pkg]}" ]] ||
      fail "$pkg is installed as '$(in_chroot pacman -Q "$pkg" 2>&1)', not the patched ${PATCHED[$pkg]}"
  done
  # aquamarine's alpha-variant fallback (omarchy-pkgs#2739), and the API edge's Hyprland 9 calls.
  local aq
  aq=$(ls "$T"/usr/lib/libaquamarine.so.*.* 2>/dev/null | head -1)
  [[ -n $aq ]] && grep -aqF "not offered by the scanout plane" "$aq" ||
    fail "aquamarine lacks the alpha-variant scanout fallback (omarchy-pkgs#2739)"
  grep -aqF showsAdoptedPicture "$aq" || fail "aquamarine lacks showsAdoptedPicture, which edge's Hyprland 9 calls"

  log "owner setup: kmscon draws through the framebuffer"
  local kmscon=$T/usr/share/omarchy/install/provisioning/kmscon.sh
  [[ $(grep -c '^[[:space:]]*exec kmscon \\$' "$kmscon" 2>/dev/null) == 1 ]] ||
    fail "${kmscon#$T} no longer has exactly one 'exec kmscon \\' line; recheck the --no-drm edit"
  sed -i 's/^\([[:space:]]*\)exec kmscon \\$/\1exec kmscon --no-drm \\/' "$kmscon"
  grep -q '^[[:space:]]*exec kmscon --no-drm \\$' "$kmscon" || fail "could not add --no-drm to ${kmscon#$T}"

  local kver
  kver=$(ls "$T/usr/lib/modules" | grep -- '-ARCH$' | sort -V | tail -1)
  [[ $kver == 7.3.* ]] || fail "unexpected kernel release $kver"
  [[ $(ls "$T/usr/lib/modules") == "$kver" ]] || fail "more than one kernel is installed: $(ls "$T/usr/lib/modules")"
  [[ -f $T/usr/lib/modules/$kver/dtbs/t6041-j616c.dtb ]] || fail "the kernel has no t6041-j616c.dtb"
  # aurora-silicon/linux#1954 (the 27.2 ANE profile names its firmware build) and
  # #2233 (the computed spatial noise filter): Aurora's 7.3.0.aurora1-41 has neither.
  module_has "$kver" drivers/accel/ane/ane_t6021 26B123 ||
    fail "the kernel's ANE driver has no 27.2 (26B123) profile: it predates aurora-silicon/linux#1954"
  module_has "$kver" drivers/media/platform/apple/isp/apple-isp isp_setfile_snf_radial ||
    fail "the kernel's ISP driver has no computed noise filter: it predates aurora-silicon/linux#2233"
  module_has "$kver" drivers/gpu/drm/asahi/aurora "26B123 for T6041 (normalized loaded image, 32-core J616C)" ||
    fail "the kernel's GPU driver does not admit the 32-core J616c's 26B123 image (patches/linux-t6041-26b123-32core.patch)"
  log "kernel $kver, with linux#1954, #2233 and the 32-core J616c's 26B123 GPU image"

  log "checking the audio stack and starting speakersafetyd on the J616"
  grep -q '^\[Speaker/' "$T/usr/share/speakersafetyd/apple/j616.conf" 2>/dev/null ||
    fail "no speakersafetyd profile with speakers for J616 (apple/j616.conf)"
  for p in graph.json mic.json; do
    [[ -s $T/usr/share/asahi-audio/j616/$p ]] || fail "aurora-audio has no J616 $p (asahi-audio/j616)"
  done
  install -D -m 0644 /tools/image/96-speakersafetyd-j616.rules "$T/etc/udev/rules.d/96-speakersafetyd-j616.rules"
  # If speakersafetyd's own rule ever starts it for the J616, this file is redundant.
  if grep -Eq '^KERNEL==.*ATTRS\{id\}=="AppleJ616".*SYSTEMD_WANTS' "$T/usr/lib/udev/rules.d/95-speakersafetyd.rules" 2>/dev/null; then
    log "note: speakersafetyd's own rule now starts it for AppleJ616; 96-speakersafetyd-j616.rules can go"
  fi

  log "checking the VA-API bridge for the video decoder"
  # libva loads <DRM driver name>_drv_video.so, and the kernel names the GPU's driver "aurora" (OMS-4).
  [[ $(readlink "$T/usr/lib/dri/aurora_drv_video.so") == v4l2_request_drv_video.so &&
     -f $T/usr/lib/dri/v4l2_request_drv_video.so ]] ||
    fail "libva-v4l2_request-avd does not install aurora_drv_video.so -> v4l2_request_drv_video.so"

  log "installing Realtek firmware for USB dongles"
  in_chroot pacman -S --noconfirm "${DONGLE_FIRMWARE[@]}" >>"$W/pacman.log" 2>&1 ||
    fail "could not install the Realtek dongle firmware (pacman.log)"
  # Arch Linux ARM ships it plain, x86 Arch zstd-compressed; the kernel loads either.
  in_chroot pacman -Qlq linux-firmware-realtek | grep -Eq '/rtl_nic/rtl8153b-2\.fw(\.zst)?$' ||
    fail "linux-firmware-realtek has no rtl_nic/rtl8153b-2.fw for RTL8153B USB Ethernet adapters"

  log "x86-64 containers: qemu-user-static from omarchy-pkgs $QEMU_PR_COMMIT, aurora-userpages, containerd under userpages 4k"
  [[ -f $T/usr/lib/systemd/system/containerd.service ]] || fail "the image lacks containerd; recheck OMS-41"
  for pkg in qemu-user-static qemu-user-static-binfmt; do
    [[ $(in_chroot pacman -Q "$pkg" 2>/dev/null) == "$pkg $QEMU_VERSION" ]] ||
      fail "$pkg is installed as '$(in_chroot pacman -Q "$pkg" 2>&1)', not $QEMU_VERSION"
  done
  # The package's own rule, with F (fix binary), which keeps the interpreter usable
  # inside containers. An override in /etc would take precedence over it.
  grep -Eq '^:qemu-x86_64:.*:/usr/bin/qemu-x86_64-static:[A-Z]*F[A-Z]*$' "$T/usr/lib/binfmt.d/$QEMU_BINFMT" ||
    fail "$QEMU_BINFMT does not name /usr/bin/qemu-x86_64-static with the F flag"
  [[ ! -e $T/etc/binfmt.d/$QEMU_BINFMT ]] || fail "/etc/binfmt.d/$QEMU_BINFMT would override the package's rule"
  [[ -x $T/usr/bin/userpages ]] || fail "aurora-userpages installed no userpages command"
  install -D -m 0644 /tools/image/containerd-user4k.conf \
    "$T/etc/systemd/system/containerd.service.d/50-user4k.conf"
  # userpages refuses 4k without user4k=on. It reaches the kernel command line
  # from aurora-userpages' GRUB drop-in and from omarchy-mac-boot's setup, which
  # adds it on linux-aurora; both feed Limine.
  grep -qs 'user4k=on' "$T/etc/default/grub.d/50-aurora-user4k.cfg" ||
    fail "aurora-userpages no longer ships the user4k=on GRUB drop-in"
  grep -qs 'user4k=on' "$T/usr/lib/omarchy-mac/boot/setup/grub-console.sh" ||
    fail "omarchy-mac-boot's setup no longer adds user4k=on; containerd's userpages 4k needs it"

  in_chroot pacman -Dk >>"$W/pacman.log" 2>&1 || fail "the package database has missing dependencies"
  in_chroot pacman -Q "${!EDGE_PINS[@]}" "${!PATCHED[@]}" "${DONGLE_FIRMWARE[@]#core/}" \
    qemu-user-static qemu-user-static-binfmt aurora-userpages | sort | tee "$W/versions.txt"
  # And what got installed is exactly what was pinned.
  for pkg in "${!EDGE_PINS[@]}"; do
    [[ $(in_chroot pacman -Q "$pkg" 2>/dev/null) == "$pkg ${EDGE_PINS[$pkg]}" ]] ||
      fail "$pkg is installed as '$(in_chroot pacman -Q "$pkg" 2>&1)', not the pinned ${EDGE_PINS[$pkg]}"
  done

  log "checking the UKI carries the new kernel"
  local uki=$T/boot/efi/EFI/Linux/omarchy_linux-aurora.efi
  [[ -s $uki ]] || fail "no UKI at ${uki#$T}"
  python3 - "$uki" "$kver" <<'PY' || fail "the UKI does not carry $kver"
import sys
data = open(sys.argv[1], "rb").read()
raise SystemExit(0 if sys.argv[2].encode() in data else 1)
PY

  log "Stage 2 from aura $STAGE1_COMMIT, kept for every later update-m1n1"
  install -D -m 0644 /stage2.bin "$T$STAGE2_PATH"
  local defaults=$T/etc/default/update-m1n1
  [[ -f $defaults ]] || fail "the image has no /etc/default/update-m1n1 (omarchy-mac-boot)"
  ! grep -Eq '^[[:space:]]*(export[[:space:]]+)?M1N1=' "$defaults" || fail "/etc/default/update-m1n1 already sets M1N1"
  # omarchy-mac-boot-ctxr refuses to refresh boot-ctxr.bin when TARGET is set here.
  ! grep -Eq '^[[:space:]]*(export[[:space:]]+)?TARGET=' "$defaults" || fail "/etc/default/update-m1n1 sets TARGET"
  ! grep -q '^[[:space:]]*M1N1_UPDATE_DISABLED' "$defaults" || fail "/etc/default/update-m1n1 disables Stage 2 rebuilds"
  printf '\n# J616c on 27.2 firmware: Stage 2 from aura %s (v1.0.0b17), which has\n# aura#265; edge'"'"'s aura package predates it (omarchy-m4 OMS-30). Remove once\n# the aura package carries aura#265 and the M4 27.2 GPU hand-off.\nM1N1=%s\n' \
    "$STAGE1_COMMIT" "$STAGE2_PATH" >>"$defaults"
  [[ -f $T/usr/share/libalpm/hooks/95-m1n1-install.hook ]] || fail "update-m1n1's pacman hook is missing"
  [[ -x $T/usr/share/libalpm/scripts/omarchy-mac-boot-ctxr ]] ||
    fail "omarchy-mac-boot no longer ships omarchy-mac-boot-ctxr, which keeps boot-ctxr.bin current"
  # Stock update-m1n1, not Aurora's bootchain wrapper: the ctxr hook defers to that one.
  ! grep -Fq AURORA_BOOTCHAIN "$T/usr/bin/update-m1n1" || fail "update-m1n1 is Aurora's bootchain wrapper, not aurora-scripts'"
  # Hold the patched builds: omarchy update would replace them with edge's own.
  # Omarchy's template has no IgnorePkg line, so add one under [options].
  local ignored
  ignored=$(in_chroot pacman-conf IgnorePkg | tr '\n' ' ') || fail "pacman-conf could not read IgnorePkg"
  [[ -z $ignored ]] || fail "pacman already ignores packages: $ignored"
  sed -i "/^\[options\]/a IgnorePkg = $HOLDS" "$T/etc/pacman.conf"
  ignored=$(in_chroot pacman-conf IgnorePkg | tr '\n' ' ')
  [[ $ignored == "$HOLDS " ]] || fail "pacman's IgnorePkg is '$ignored', not the holds '$HOLDS'"
  # Omarchy's boot check accepts an M1N1= Stage 2 only when the boot loader package owns it
  # (omarchy-apple-silicon-boot-check: "M1N1 … is not owned by aura"), so with the pin every
  # omarchy update would stop. The marker leaves verification to the owner; update-verify
  # still refreshes boot-ctxr.bin with it present (JOURNEY 9.62).
  install -D -m 0644 /dev/stdin "$T/etc/omarchy-mac-boot/owner-boot-chain" <<EOF
Stage 2 is aura $STAGE1_COMMIT (v1.0.0b17), pinned by M1N1= in /etc/default/update-m1n1
(omarchy-m4 OMS-30): edge's aura package predates aura#265, and Omarchy's boot check accepts
only a package-owned Stage 2. Remove this file and the M1N1= line once the aura package
carries aura#265 and the M4 27.2 GPU hand-off.
EOF
  echo "aura Stage 1 and Stage 2 $STAGE1_COMMIT $STAGE1_SHA256 $STAGE2_SHA256" >>"$W/versions.txt"
  echo "qemu-user-static from omarchy-pkgs $QEMU_PR_COMMIT (omacom/omarchy-pkgs#3505, #3602, #3603)" >>"$W/versions.txt"

  log "Stage 2: boot.bin, and boot-ctxr.bin for the J616c's Mach-O path"
  # As omarchy-mac-boot-ctxr builds boot-ctxr.bin on the Mac: update-m1n1 with its
  # defaults (every device tree), into the path it is given.
  in_chroot /usr/bin/update-m1n1 /boot/efi/m1n1/boot.bin >"$W/update-m1n1.log" 2>&1 ||
    fail "update-m1n1 failed (update-m1n1.log)"
  [[ -s $T/boot/efi/m1n1/boot.bin ]] || fail "no Stage 2 written"
  rm -f "$T/boot/efi/m1n1/"*.old
  # The builder stages boot-ctxr.bin (every M4 Mac's Mach-O path, the J616c's
  # included) and boot-j700.bin (the MacBook Neo) as byte-identical copies of
  # boot.bin, and mac-image-check payload holds them to that.
  local copy
  for copy in boot-ctxr.bin boot-j700.bin; do
    [[ -f $T/boot/efi/m1n1/$copy ]] || fail "the edge image has no m1n1/$copy"
    install -m 0644 "$T/boot/efi/m1n1/boot.bin" "$T/boot/efi/m1n1/$copy"
  done
  python3 - "$T/boot/efi/m1n1/boot-ctxr.bin" "$T/usr/lib/modules/$kver/dtbs/t6041-j616c.dtb" \
    "$T/usr/lib/asahi-boot/u-boot-nodtb.bin" <<'PY' || fail "the J616c Stage 2 lacks its tree or U-Boot"
import gzip, sys
stage2 = open(sys.argv[1], "rb").read()
dtb = open(sys.argv[2], "rb").read()
uboot = open(sys.argv[3], "rb").read()
def contains(blob):
    if blob in stage2:
        return True
    # update-m1n1 gzips U-Boot; look inside every gzip member.
    i = 0
    while (i := stage2.find(b"\x1f\x8b\x08", i)) >= 0:
        try:
            if blob in gzip.decompress(stage2[i:]):
                return True
        except Exception:
            pass
        i += 3
    return False
raise SystemExit(0 if contains(dtb) and contains(uboot) else 1)
PY
  for p in boot.bin boot-ctxr.bin; do
    cmp -s -n "$(stat -c %s /stage2.bin)" /stage2.bin "$T/boot/efi/m1n1/$p" || fail "m1n1/$p does not start with the aura $STAGE1_COMMIT Stage 2"
  done
  if (($(stat -c %s "$T/boot/efi/m1n1/boot-ctxr.bin") > 16 * 1024 * 1024)); then
    fail "the confined Stage 2 exceeds aura's 16 MiB slot"
  fi

  log "Stage 1: aura $STAGE1_COMMIT's Mach-O object"
  # Every M4 Mac's Stage 1, the J616c's included: the engine fills its
  # configuration block, and Recovery pads it for the execute window and enrolls
  # it with kmutil --compress. Edge's aura package predates aura#265, so its
  # object is replaced. mac-image-check payload checks the object (kcbz 0, one
  # configuration block).
  [[ -f $T/boot/efi/aurora/stage1.macho ]] || fail "the edge image has no esp/aurora/stage1.macho"
  install -m 0644 /stage1.macho "$T/boot/efi/aurora/stage1.macho"
  [[ $(grep -ac 'AURORA-S1-CFG01' /stage1.macho) == 1 ]] || fail "the Stage 1 object has no single configuration block"

  log "mounting /boot/efi and /boot from the install the Mac boots"
  # fstab stays as the image builder writes it (mac-image-check pins the line);
  # the generator's units take precedence over fstab's at every boot.
  # The generator copies these lines' UUIDs, options and fsck pass, so match all of them.
  grep -Eq '^UUID=4F4D-5801[[:space:]]+/boot/efi[[:space:]]+vfat[[:space:]]+umask=0077[[:space:]]+0[[:space:]]+2[[:space:]]*$' "$T/etc/fstab" ||
    fail "fstab's /boot/efi line isn't the one omarchy-esp-generator replaces (UUID=4F4D-5801, umask=0077, pass 2)"
  grep -Eq '^UUID=4f4d5801-424f-4f54-8000-000000000001[[:space:]]+/boot[[:space:]]+ext4[[:space:]]+defaults,noatime[[:space:]]+0[[:space:]]+2[[:space:]]*$' "$T/etc/fstab" ||
    fail "fstab's /boot line isn't the one omarchy-esp-generator replaces (UUID=4f4d5801-424f-…-0001, defaults,noatime, pass 2)"
  install -D -m 0755 /tools/image/omarchy-esp-generator \
    "$T/usr/local/lib/systemd/system-generators/omarchy-esp-generator"

  log "cleaning up the root"
  rm -rf "$T/etc/pacman.d/gnupg"
  find "$T/var/cache/pacman/pkg" -mindepth 1 -delete
  rm -f "$T/etc/resolv.conf"
  [[ -z $resolv_backup ]] || cp -a "$resolv_backup" "$T/etc/resolv.conf"
  rm -f "$T/boot/efi/.builder"
  find "$T/etc" -name '*.pacnew' | tee "$W/pacnew.txt"

  [[ -d $T/boot/efi/aurora/recovery ]] || fail "the edge image carries no native Recovery app"

  log "copying the ESP out"
  rm -rf "$W/payload/esp" && mkdir "$W/payload/esp"
  cp -a "$T/boot/efi/." "$W/payload/esp/"

  log "re-sealing @factory"
  local sealed
  sealed=$(cat "$W/top/@factory/var/lib/omarchy/factory-sealed")
  local i
  for ((i = ${#mounts[@]} - 1; i >= 0; i--)); do
    [[ ${mounts[i]} == "$W/top" ]] && continue
    umount -l "${mounts[i]}"
    unset 'mounts[i]'
  done
  mounts=("$W/top")
  btrfs property set -ts "$W/top/@factory" ro false
  btrfs subvolume delete "$W/top/@factory" >/dev/null
  btrfs subvolume snapshot "$W/top/@" "$W/top/@factory.new" >/dev/null
  local new=$W/top/@factory.new
  rm -rf -- "$new/var/lib/omarchy/first-boot" "$new/var/lib/omarchy/mac-first-boot" \
    "$new/var/lib/omarchy/provisioning/pending" "$new/etc/pacman.d/gnupg" "$new/var/lib/omarchy/backups" \
    "$new/var/cache/pacman/pkg/"* \
    "$new/etc/NetworkManager/system-connections/"* "$new/var/lib/NetworkManager/"* "$new/var/lib/iwd"
  install -d -m 0755 "$new/var/lib/omarchy"
  printf '%s\n' "$sealed" >"$new/var/lib/omarchy/factory-sealed"
  chmod 0644 "$new/var/lib/omarchy/factory-sealed"
  btrfs property set -ts "$new" ro true
  mv -T "$new" "$W/top/@factory"
  btrfs filesystem sync "$W/top"
  local free
  free=$(btrfs filesystem usage -b "$W/top" 2>/dev/null | awk '/Free \(estimated\)/ { print $3; exit }')
  log "root free space: $free bytes"
  [[ $free =~ ^[0-9]+$ ]] && ((free >= 512 * 1024 * 1024)) || fail "too little free space left in the root"
  cleanup
  mounts=()
  loops=()
  e2fsck -fn "$W/payload/boot.img" >/dev/null || fail "boot.img does not check clean"
  btrfs check --readonly "$W/payload/root.img" >/dev/null 2>&1 || fail "root.img does not check clean"

  log "packaging"
  name=$(basename "$zip" | sed 's/-mac-edge-os-package\.zip$/-mac-edge-j616c-dev-os-package.zip/')
  [[ $name != "$(basename "$zip")" ]] || fail "unexpected payload name"
  (cd "$W/payload" && bsdtar --format zip -cf "/out/$name" esp boot.img root.img omarchy-volume.icns)
  # The metadata stays the builder's own, apart from the payload's name:
  # mac-image-check holds it to that exactly, supported_fw included. The J616c's
  # 27.2 stub comes from the developer catalog's installer_data-j616c.json.
  python3 - "$data" "/out/installer_data.json" "$name" <<'PY'
import json, sys
data = json.load(open(sys.argv[1]))
[target] = data["os_list"]
target["package"] = sys.argv[3]
json.dump(data, open(sys.argv[2], "w"), indent=2)
open(sys.argv[2], "a").write("\n")
PY
  cp "$W/versions.txt" "$W/pacman.log" "$W/update-m1n1.log" "$W/keyring.log" "$W/pacnew.txt" /out/
  (cd /out && sha256sum "$name" >"$name.sha256" && stat -c '%s %n' "$name")
  log "done"
}

if [[ ${1:-} == --in-container ]]; then
  container
else
  host "$@"
fi
