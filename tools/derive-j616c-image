#!/bin/bash
# Derive a developer-only J616c (MacBook Pro 16-inch, M4 Max) Omarchy payload
# from an edge payload built by omarchy-mac-installer's image-builder.
#
# Local developer tooling, not a release producer. It:
#   - adds Aurora Silicon's signed ALARM repository ([aurora], key
#     A33623FB30665BEFAA0FFB6DE35EC749219B20F7) first in pacman.conf, and its
#     keyring package. First boot builds the Mac's keyring from archlinuxarm,
#     asahi-alarm and omarchy only, so a drop-in on omarchy-provision-owner adds
#     aurora before owner setup (without it pacman waits on a hidden Y/n prompt);
#   - replaces the boot chain with Aurora's: linux-aurora (with t6041-j616c.dtb),
#     aura (raw and Mach-O Stage 1, monitor-free Stage 2 m1n1), uboot-aurora
#     (T6041-capable) and Aurora's asahi-scripts (bootchain update-m1n1), plus
#     Aurora's mesa-aurora and vulkan-aurora built for that kernel (the edge
#     image's older Mesa cannot drive the J616c GPU under it), and Aurora's
#     speakersafetyd profiles: speakersafetyd trims apple,j616c to apple/j616.conf,
#     which only speakersafetyd-aurora-profiles ships; without it the daemon fails,
#     the amps stay locked and there is no speaker sink (OMS-1). Also Aurora's
#     aurora-audio: the edge image's build (4.1.aurora3-3) has no J616 speaker or
#     mic graph, Aurora's (4.1.aurora2-16) does, though its pkgrel sorts lower;
#   - swaps Omarchy's libva-v4l2_request-avd for Aurora's libva-v4l2-request-avd:
#     the same AVD VA-API bridge, but aliased as aurora_drv_video.so, the name
#     libva looks for under Aurora's kernel; without it VA-API found no driver and
#     video decoded in software (OMS-4);
#   - pins the exact [aurora] builds it was tested with (AURORA_PINS: kernel,
#     aura, U-Boot, asahi-scripts, Mesa, audio, VA-API) and stops if the repo has moved on;
#   - installs linux-firmware-realtek from [core]: the image ships no linux-firmware
#     split, so USB-C Ethernet dongles on RTL8153B (and Realtek USB Wi-Fi and
#     Bluetooth) ran without their firmware (OMS-7);
#   - uses a Stage 2 built from aura main with aaec599f (restarts the post-M4
#     ANS that Stage 1 powers off; no aura release has it yet), installed at
#     /usr/local/lib/aura and named in /etc/default/update-m1n1, so every later
#     kernel, U-Boot or aura update rebuilds boot-ctxr.bin with it;
#   - pins IgnorePkg = m1n1-aurora, which declares replaces=aura;
#   - keeps updates safe without hand guards (OMS-13): the kernel, Mesa, U-Boot
#     and aura update from [aurora]; every boot-chain change rebuilds Stage 2
#     from the pinned aura Stage 2 and Aurora's trial boots it once (committed
#     when Linux comes up; a trial that never gets there falls back after a
#     reset); it makes sure no Stage 2 trial state ships; and it ships
#     /etc/omarchy-mac-boot/owner-boot-chain, since Omarchy's boot check can't
#     verify a Stage 2 that Aurora's update-m1n1 builds;
#   - makes the trial guard count its 12 minutes from when the unlocked system
#     starts, not from kernel start, so time at the disk password doesn't roll
#     back a good trial (OMS-17);
#   - installs omarchy-esp-generator (tools/image), which mounts /boot/efi from
#     the ESP aura names in the device tree rather than fstab's UUID=4F4D-5801,
#     which every Omarchy ESP shares (OMS-12), and /boot from the partition
#     after it rather than the Boot UUID every install shares (OMS-15);
#   - lets x86-64 containers run (OMS-41): installs qemu-user-static and
#     qemu-user-static-binfmt built from omacom/omarchy-pkgs#3505 (QEMU 11.1.3
#     with three linux-user patches; the QEMU_PKGS input, pinned by
#     QEMU_PKG_SHA256) over the image's Debian build, and runs containerd under
#     Aurora's userpages 4k (tools/image/containerd-user4k.conf), since x86
#     libraries built for 4 KiB pages don't map on the 16 KiB kernel. The Debian
#     qemu-user also hands x86-64 programs addresses above 2^47, has no Linux AIO
#     and reports trapno -1: SQL Server 2022 needs all three fixed. The PR's
#     version sorts above the Debian build, so updates keep it, and take
#     omarchy's own build once it publishes a higher one;
#   - lets the image's own hooks rebuild the UKI, then builds the standard and
#     the J616c confined Stage 2 with Aurora's update-m1n1;
#   - stages esp/aurora/stage1-j616c.bin (aura's raw Stage 1, which the installer
#     enrolls raw as raw-ctxr, OMS-24) and esp/m1n1/boot-ctxr-j616c.bin;
#   - re-seals @factory and packages the payload with its installer_data.json.
#
# Run on an aarch64 Linux host with
# Docker and passwordless sudo:
#   derive-j616c-image EDGE_OUT_DIR ROOTFS_TARBALL AURORA_KEY RECOVERY_DIR STAGE2 QEMU_PKGS OUTPUT_DIR
# STAGE2 is build/aura.bin from aura STAGE2_COMMIT built with the aura PKGBUILD's
# Stage 2 flags (RELEASE=1 CHAINLOADING=1 ESP_STAGE2=1 USE_CLANG=1
# BUILTIN_LOGO=aurora); its sha256 must be STAGE2_SHA256.
# QEMU_PKGS is a directory holding the two packages omarchy-pkgs builds at
# QEMU_PR_COMMIT (`bin/build --arch aarch64 --package qemu-user-static`, files
# under build-output/edge/aarch64/); each must match QEMU_PKG_SHA256.
# RECOVERY_DIR is a Recovery/build-recovery.sh output built from the branch with
# the raw-ctxr boot mode (OMS-24); it replaces the edge image's Recovery app, which
# predates that mode and would refuse this Mac's installation configuration.
set -euo pipefail

AURORA_FPR=A33623FB30665BEFAA0FFB6DE35EC749219B20F7
AURORA_SERVER='https://aurorasilicon.org/alarm-aurora/testing/$arch'
AURORA_BOOT=(aurora/linux-aurora aurora/linux-aurora-headers aurora/aurora-userpages
  aurora/aura aurora/uboot-aurora aurora/asahi-scripts)
J616C_COMPATIBLE='apple,j616c apple,t6041 apple,arm-platform'
# Aurora's Mesa for its kernel; the -fex-guest and lavapipe variants only when the image has them.
AURORA_MESA=(mesa-aurora vulkan-aurora)
AURORA_MESA_OPTIONAL=(mesa-aurora-fex-guest vulkan-lavapipe-aurora)
# speakersafetyd looks for apple/j616.conf on a J616c; only this package has it.
# aurora-audio: the J616 speaker and mic DSP graphs (asahi-audio/j616).
AURORA_AUDIO=(aurora/speakersafetyd-aurora-profiles aurora/aurora-audio)
# Realtek firmware for USB-C dongles: the r8152 Ethernet family (RTL8153B wants
# rtl_nic/rtl8153b-2.fw), Realtek USB Wi-Fi and Bluetooth. The image ships no
# linux-firmware split, since the Mac's own firmware comes from macOS (OMS-7).
DONGLE_FIRMWARE=(core/linux-firmware-realtek)
# libva loads <DRM driver name>_drv_video.so, and Aurora's kernel names the GPU's
# driver "aurora". Omarchy's libva-v4l2_request-avd aliases the AVD bridge only as
# asahi_drv_video.so, so VA-API found no driver and mpv decoded in software (OMS-4).
# Aurora's build is the same omacom/libva-v4l2_request driver with the aurora alias.
VAAPI_OMARCHY=libva-v4l2_request-avd
VAAPI_AURORA=libva-v4l2-request-avd
# The exact [aurora] builds this image is made and tested with. Aurora's repo keeps
# only its latest build, so a pin can't fetch an older one: it stops the build when
# the repo has moved on, so a new kernel, Stage 1 or Mesa never ships untested.
# Bump these on purpose, and record why in JOURNEY.
declare -A AURORA_PINS=(
  [linux-aurora]=7.3.0.aurora1-40
  [linux-aurora-headers]=7.3.0.aurora1-40
  [aura]=1.0.0b13.1-1
  [uboot-aurora]=2026.07.aurora11-1
  [asahi-scripts]=20261023-9
  [mesa-aurora]=1:26.3.0_devel.202611150611.d4ad4a4dce6-1
  [vulkan-aurora]=1:26.3.0_devel.202611150611.d4ad4a4dce6-1
  [aurora-audio]=4.1.aurora2-16
  [speakersafetyd-aurora-profiles]=1-2
  [alsa-utils-aurora]=1.2.16-1
  [libva-v4l2-request-avd]=1.3.r11-1
)
STAGE2_COMMIT=94d8e6e4
STAGE2_SHA256=46fd25ed3562057ef1856c99da3e6ceab2e33c29c21800635a11f3468092d068
STAGE2_PATH=/usr/local/lib/aura/m1n1-$STAGE2_COMMIT.bin
# qemu-user-static from omacom/omarchy-pkgs#3505, the build installed and tested
# on the Mac with SQL Server 2022 (OMS-41, JOURNEY 9.55). Drop the input once
# omarchy's repo publishes it.
QEMU_PR_COMMIT=c61ca8b62661
QEMU_VERSION=1:11.1.3-1
declare -A QEMU_PKG_SHA256=(
  [qemu-user-static]=6b31a8986c0b73f009110f3f064f91c4acf6317056ec6367cbff9d2b10fbdc23
  [qemu-user-static-binfmt]=418349063bb0fc15098f4cd3b160f9c0ddcba066ced7d021d487c71123c0df3b
)
QEMU_BINFMT=qemu-x86_64-static.conf

log() { printf '[%4ss] %s\n' "$SECONDS" "$*"; }
fail() { printf 'derive-j616c-image: %s\n' "$*" >&2; exit 1; }

host() {
  local edge=$1 rootfs=$2 key=$3 recovery=$4 stage2=$5 qemu=$6 out=$7 image pkg file
  [[ -d $edge && -f $rootfs && -f $key && -f $recovery/omarchy-recovery-app.json \
    && -d "$recovery/Omarchy Installer.app" && -f $stage2 && -d $qemu ]] ||
    fail "usage: $0 EDGE_OUT ROOTFS AURORA_KEY RECOVERY_DIR STAGE2 QEMU_PKGS OUT"
  [[ $(sha256sum "$stage2" | cut -d' ' -f1) == "$STAGE2_SHA256" ]] || fail "$stage2 is not the pinned aura $STAGE2_COMMIT Stage 2"
  for pkg in "${!QEMU_PKG_SHA256[@]}"; do
    file=$qemu/$pkg-$QEMU_VERSION-aarch64.pkg.tar.zst
    [[ -f $file ]] || fail "$qemu has no $(basename "$file") (omarchy-pkgs at $QEMU_PR_COMMIT)"
    [[ $(sha256sum "$file" | cut -d' ' -f1) == "${QEMU_PKG_SHA256[$pkg]}" ]] ||
      fail "$file is not the pinned build from omarchy-pkgs $QEMU_PR_COMMIT"
  done
  mkdir -p "$out"
  [[ -z $(ls -A "$out") ]] || fail "$out is not empty"
  image=omarchy-j616c-derive:$(sha256sum "$rootfs" | cut -c1-16)
  if ! sudo docker image inspect "$image" >/dev/null 2>&1; then
    sudo docker import --platform linux/arm64 "$rootfs" "$image" >/dev/null
  fi
  sudo docker run --rm --privileged --platform linux/arm64 \
    -v "$(cd "$(dirname "$0")" && pwd):/tools:ro" -v "$(cd "$edge" && pwd):/edge:ro" \
    -v "$(cd "$(dirname "$key")" && pwd)/$(basename "$key"):/aurora.asc:ro" \
    -v "$(cd "$recovery" && pwd):/recovery:ro" -v "$(cd "$out" && pwd):/out" -v /work \
    -v "$(cd "$(dirname "$stage2")" && pwd)/$(basename "$stage2"):/stage2.bin:ro" \
    -v "$(cd "$qemu" && pwd):/qemu-pkgs:ro" \
    "$image" /bin/bash /tools/derive-j616c-image --in-container
}

mounts=()
loops=()
cleanup() {
  local rc=$? i
  # The work volume goes with the container: on a failure, keep its logs.
  if ((rc != 0)) && [[ -d /out && -n ${W:-} ]]; then
    mkdir -p /out/failed-logs && cp -p "$W"/*.log "$W"/*.txt /out/failed-logs/ 2>/dev/null || true
  fi
  for ((i = ${#mounts[@]} - 1; i >= 0; i--)); do umount "${mounts[i]}" 2>/dev/null || umount -l "${mounts[i]}" 2>/dev/null || true; done
  for i in "${loops[@]}"; do losetup -d "$i" 2>/dev/null || true; done
}

mnt() {  # mnt TARGET mount-args...
  local target=$1
  shift
  mkdir -p "$target"
  mount "$@" "$target" || fail "could not mount $target"
  mounts+=("$target")
}

loop() {  # loop VAR FILE: attach FILE and name its device in VAR. Not in a
  # subshell, so cleanup sees every device it attached.
  local device
  device=$(losetup -f --show "$2") || fail "no loop device for $2"
  loops+=("$device")
  printf -v "$1" %s "$device"
}

in_chroot() { chroot "$T" /usr/bin/env -i PATH=/usr/bin:/usr/sbin HOME=/root LC_ALL=C "$@"; }

container() {
  trap cleanup EXIT
  W=/work T=/work/target
  cd "$W"
  log "toolchain"
  pacman-key --init >/dev/null 2>&1
  pacman-key --populate archlinuxarm >/dev/null 2>&1
  pacman -Sy --noconfirm --needed btrfs-progs dosfstools e2fsprogs libarchive gnupg python >/work/toolchain.log 2>&1 ||
    fail "could not install the toolchain"

  local zip data name
  zip=$(ls /edge/*-os-package.zip)
  [[ $(wc -l <<<"$zip") == 1 ]] || fail "expected one payload in /edge"
  data=/edge/installer_data.json
  log "unpacking $(basename "$zip")"
  mkdir -p "$W/payload"
  bsdtar -xf "$zip" -C "$W/payload"
  [[ -f $W/payload/root.img && -f $W/payload/boot.img && -d $W/payload/esp ]] || fail "unexpected payload layout"

  log "checking Aurora's key"
  install -d -m 0700 "$W/gpg"
  gpg --homedir "$W/gpg" --batch --quiet --import /aurora.asc
  gpg --homedir "$W/gpg" --batch --with-colons --fingerprint | grep -q "^fpr:::::::::$AURORA_FPR:" ||
    fail "the Aurora key is not $AURORA_FPR"

  log "mounting the image"
  truncate -s 524288000 "$W/esp.img"
  mkfs.vfat -F 32 -n OMARCHYESP -i 4f4d5801 "$W/esp.img" >/dev/null
  local root_loop boot_loop esp_loop
  loop root_loop "$W/payload/root.img"
  loop boot_loop "$W/payload/boot.img"
  loop esp_loop "$W/esp.img"
  mnt "$W/top" -o subvolid=5 "$root_loop"
  mnt "$T" -o subvol=@,compress=zstd "$root_loop"
  mnt "$T/home" -o subvol=@home,compress=zstd "$root_loop"
  mnt "$T/var/log" -o subvol=@log,compress=zstd "$root_loop"
  mnt "$T/var/cache/pacman/pkg" -o subvol=@pkg,compress=zstd "$root_loop"
  mnt "$T/boot" "$boot_loop"
  mnt "$T/boot/efi" "$esp_loop"
  cp -a "$W/payload/esp/." "$T/boot/efi/"
  # asahi-scripts keep update-m1n1 on a builder's ESP when this marker is there.
  : >"$T/boot/efi/.builder"

  # The image's platform, as image-builder presents it: a Mac's device tree
  # and the UEFI U-Boot gives, with no EFI variables.
  mnt "$T/proc" -t proc proc
  mnt "$T/sys" -t sysfs -o ro sysfs
  mnt "$T/sys/firmware" -t tmpfs -o mode=0755,size=1m tmpfs
  mkdir -p "$T/sys/firmware/devicetree/base" "$T/sys/firmware/efi/efivars"
  printf '%s\0' apple,arm-platform >"$T/sys/firmware/devicetree/base/compatible"
  printf 'Omarchy image (apple-silicon)\0' >"$T/sys/firmware/devicetree/base/model"
  mnt "$T/dev" --rbind /dev
  mnt "$T/run" -t tmpfs -o mode=0755 tmpfs
  mkdir -p "$T/run/lock"
  mnt "$T/tmp" -t tmpfs -o mode=1777 tmpfs
  cp -L /etc/resolv.conf "$T/run/resolv.conf"
  local resolv_backup=""
  if [[ -e $T/etc/resolv.conf || -L $T/etc/resolv.conf ]]; then
    resolv_backup=$W/resolv.conf.image
    cp -a "$T/etc/resolv.conf" "$resolv_backup"
    rm -f "$T/etc/resolv.conf"
  fi
  cp -L /etc/resolv.conf "$T/etc/resolv.conf"

  log "temporary keyring with Aurora's key"
  [[ ! -e $T/etc/pacman.d/gnupg ]] || fail "the image already has a pacman keyring"
  in_chroot pacman-key --init >"$W/keyring.log" 2>&1
  in_chroot pacman-key --populate >>"$W/keyring.log" 2>&1
  cp /aurora.asc "$T/tmp/aurora.asc"
  in_chroot pacman-key --add /tmp/aurora.asc >>"$W/keyring.log" 2>&1
  in_chroot pacman-key --lsign-key "$AURORA_FPR" >>"$W/keyring.log" 2>&1

  log "pacman.conf: [aurora] first, m1n1-aurora ignored"
  python3 - "$T/etc/pacman.conf" "$AURORA_SERVER" <<'PY'
import re, sys
path, server = sys.argv[1], sys.argv[2]
text = open(path).read()
if "[aurora]" in text:
    raise SystemExit("pacman.conf already has [aurora]")
block = ("# Aurora Silicon's signed ALARM repository: the M4 Max (J616c) kernel,\n"
         "# aura and U-Boot. First, so the boot chain keeps coming from it.\n"
         f"[aurora]\nServer = {server}\n\n")
first = re.search(r"^\[(?!options\])[^\]]+\]", text, re.M)
text = text[:first.start()] + block + text[first.start():]
pin = ("# m1n1-aurora declares replaces=aura; on a J616c it would swap aura's\n"
       "# T6041 Stage 2 for one that cannot boot it.\nIgnorePkg = m1n1-aurora\n")
text = re.sub(r"^\[options\]\n", "[options]\n" + pin, text, count=1, flags=re.M)
open(path, "w").write(text)
PY

  log "installing Aurora's boot chain"
  in_chroot pacman -Sy --noconfirm >"$W/pacman.log" 2>&1 || fail "pacman -Sy failed (pacman.log)"
  in_chroot pacman -S --noconfirm aurora/aurora-keyring >>"$W/pacman.log" 2>&1 ||
    fail "could not install aurora-keyring"
  # Before installing anything else: the repo must still offer exactly the pinned builds.
  local pkg have moved=()
  for pkg in "${!AURORA_PINS[@]}"; do
    have=$(in_chroot pacman -Si "aurora/$pkg" 2>/dev/null | sed -n 's/^Version *: //p')
    [[ $have == "${AURORA_PINS[$pkg]}" ]] || moved+=("$pkg: pinned ${AURORA_PINS[$pkg]}, [aurora] has ${have:-nothing}")
  done
  ((${#moved[@]} == 0)) ||
    fail "[aurora] no longer offers the pinned builds; review them, then bump AURORA_PINS: $(printf '%s; ' "${moved[@]}")"
  in_chroot pacman -Rdd --noconfirm m1n1-aurora >>"$W/pacman.log" 2>&1 || fail "could not remove m1n1-aurora"
  in_chroot pacman -S --noconfirm "${AURORA_BOOT[@]}" >>"$W/pacman.log" 2>&1 ||
    fail "could not install the Aurora boot chain (pacman.log)"

  log "installing Aurora's Mesa"
  local mesa=() p
  for p in "${AURORA_MESA[@]}"; do mesa+=("aurora/$p"); done
  for p in "${AURORA_MESA_OPTIONAL[@]}"; do
    if in_chroot pacman -Qq | grep -qx "$p"; then mesa+=("aurora/$p"); fi
  done
  in_chroot pacman -S --noconfirm "${mesa[@]}" >>"$W/pacman.log" 2>&1 ||
    fail "could not install Aurora's Mesa (pacman.log)"
  for p in "${mesa[@]}"; do
    [[ $(in_chroot pacman -Q "${p#aurora/}" | cut -d' ' -f2) == "$(in_chroot pacman -Si "$p" | sed -n 's/^Version *: //p')" ]] ||
      fail "${p#aurora/} is not Aurora's build"
  done

  log "installing Aurora's speakersafetyd profiles and aurora-audio"
  # They need Aurora's alsa-utils-aurora, which conflicts with Arch's alsa-utils, and
  # --noconfirm answers "no" to removing it. Swap it explicitly (OMS-14: this step had
  # been done by hand on the Mac).
  if in_chroot pacman -Qq alsa-utils 2>/dev/null | grep -qx alsa-utils; then
    in_chroot pacman -Rdd --noconfirm alsa-utils >>"$W/pacman.log" 2>&1 || fail "could not remove Arch's alsa-utils"
  fi
  in_chroot pacman -S --noconfirm aurora/alsa-utils-aurora "${AURORA_AUDIO[@]}" >>"$W/pacman.log" 2>&1 ||
    fail "could not install Aurora's speaker packages (pacman.log)"
  in_chroot pacman -Qq alsa-utils-aurora >/dev/null 2>&1 || fail "alsa-utils-aurora is not installed"
  # Anything that needed alsa-utils must still be satisfied (alsa-utils-aurora provides it).
  in_chroot pacman -Dk >>"$W/pacman.log" 2>&1 || fail "missing dependencies after the alsa-utils swap (pacman.log)"
  grep -q '^\[Speaker/' "$T/usr/share/speakersafetyd/apple/j616.conf" 2>/dev/null ||
    fail "no speakersafetyd profile with speakers for J616 (apple/j616.conf)"
  for p in graph.json mic.json; do
    [[ -s $T/usr/share/asahi-audio/j616/$p ]] || fail "aurora-audio has no J616 $p (asahi-audio/j616)"
  done
  # A commented-out rule would not start the daemon: match only a live one.
  grep -Eq '^KERNEL==.*ATTRS\{id\}=="AppleJ616".*SYSTEMD_WANTS' "$T/usr/lib/udev/rules.d/96-speakersafetyd-aurora.rules" ||
    fail "the speakersafetyd profiles don't start the daemon for the J616 speaker card"

  log "installing Aurora's VA-API bridge for the video decoder"
  # Both packages ship v4l2_request_drv_video.so and declare no conflict, so pacman
  # would stop on the shared files: remove Omarchy's first (OMS-4).
  if in_chroot pacman -Qq | grep -qx "$VAAPI_OMARCHY"; then
    in_chroot pacman -Rdd --noconfirm "$VAAPI_OMARCHY" >>"$W/pacman.log" 2>&1 ||
      fail "could not remove Omarchy's $VAAPI_OMARCHY"
  fi
  in_chroot pacman -S --noconfirm "aurora/$VAAPI_AURORA" >>"$W/pacman.log" 2>&1 ||
    fail "could not install Aurora's $VAAPI_AURORA (pacman.log)"
  # libva must find the bridge under the name Aurora's kernel gives the GPU driver.
  [[ $(readlink "$T/usr/lib/dri/aurora_drv_video.so") == v4l2_request_drv_video.so &&
     -f $T/usr/lib/dri/v4l2_request_drv_video.so ]] ||
    fail "$VAAPI_AURORA does not install aurora_drv_video.so -> v4l2_request_drv_video.so"

  log "installing Realtek firmware for USB dongles"
  in_chroot pacman -S --noconfirm "${DONGLE_FIRMWARE[@]}" >>"$W/pacman.log" 2>&1 ||
    fail "could not install the Realtek dongle firmware (pacman.log)"
  # Arch Linux ARM ships it plain, x86 Arch zstd-compressed; the kernel loads either.
  in_chroot pacman -Qlq linux-firmware-realtek | grep -Eq '/rtl_nic/rtl8153b-2\.fw(\.zst)?$' ||
    fail "linux-firmware-realtek has no rtl_nic/rtl8153b-2.fw for RTL8153B USB Ethernet adapters"

  log "x86-64 containers: qemu-user-static from omarchy-pkgs $QEMU_PR_COMMIT, containerd under userpages 4k"
  [[ -x $T/usr/bin/userpages && -f $T/usr/lib/systemd/system/containerd.service ]] ||
    fail "the image lacks aurora-userpages or containerd; recheck OMS-41"
  in_chroot pacman -Qq qemu-user-static-binfmt >/dev/null 2>&1 ||
    fail "the image has no qemu-user-static-binfmt to replace; recheck OMS-41"
  install -d "$T/tmp/qemu-pkgs"
  cp /qemu-pkgs/*-"$QEMU_VERSION"-aarch64.pkg.tar.zst "$T/tmp/qemu-pkgs/"
  in_chroot pacman -U --noconfirm /tmp/qemu-pkgs/qemu-user-static-"$QEMU_VERSION"-aarch64.pkg.tar.zst \
    /tmp/qemu-pkgs/qemu-user-static-binfmt-"$QEMU_VERSION"-aarch64.pkg.tar.zst >>"$W/pacman.log" 2>&1 ||
    fail "could not install qemu-user-static $QEMU_VERSION (pacman.log)"
  rm -rf "$T/tmp/qemu-pkgs"
  for pkg in "${!QEMU_PKG_SHA256[@]}"; do
    [[ $(in_chroot pacman -Q "$pkg" 2>/dev/null) == "$pkg $QEMU_VERSION" ]] ||
      fail "$pkg is installed as '$(in_chroot pacman -Q "$pkg" 2>&1)', not $QEMU_VERSION"
  done
  # The package's own rule, with F (fix binary), which keeps the interpreter usable
  # inside containers. An override in /etc would take precedence over it.
  grep -Eq '^:qemu-x86_64:.*:/usr/bin/qemu-x86_64-static:[A-Z]*F[A-Z]*$' "$T/usr/lib/binfmt.d/$QEMU_BINFMT" ||
    fail "$QEMU_BINFMT does not name /usr/bin/qemu-x86_64-static with the F flag"
  [[ ! -e $T/etc/binfmt.d/$QEMU_BINFMT ]] || fail "/etc/binfmt.d/$QEMU_BINFMT would override the package's rule"
  install -D -m 0644 /tools/image/containerd-user4k.conf \
    "$T/etc/systemd/system/containerd.service.d/50-user4k.conf"
  # userpages refuses 4k without user4k=on. The acceptance install had it in
  # /etc/default/limine with no hand step, set outside this script; warn if it
  # isn't visible in the image, since containers would then fail to start.
  grep -rqs 'user4k=on' "$T/etc/default/limine" "$T/etc/limine-entry-tool.d" "$T/etc/kernel" ||
    log "warning: user4k=on is not in the image's kernel command line defaults; containerd's userpages 4k needs it"

  in_chroot pacman -Dk >>"$W/pacman.log" 2>&1 || fail "the package database has missing dependencies"
  in_chroot pacman -Q linux-aurora aura uboot-aurora asahi-scripts aurora-keyring "${mesa[@]#aurora/}" \
    speakersafetyd "${AURORA_AUDIO[@]#aurora/}" "$VAAPI_AURORA" "${DONGLE_FIRMWARE[@]#core/}" \
    qemu-user-static qemu-user-static-binfmt | tee "$W/versions.txt"
  # pacman -Q also answers for a provider (aura provides m1n1-aurora): match names.
  if in_chroot pacman -Qq | grep -qx m1n1-aurora; then fail "m1n1-aurora is still installed"; fi
  # And what got installed is exactly what was pinned.
  for pkg in "${!AURORA_PINS[@]}"; do
    [[ $(in_chroot pacman -Q "$pkg" 2>/dev/null) == "$pkg ${AURORA_PINS[$pkg]}" ]] ||
      fail "$pkg is installed as '$(in_chroot pacman -Q "$pkg" 2>&1)', not the pinned ${AURORA_PINS[$pkg]}"
  done

  local kver
  kver=$(ls "$T/usr/lib/modules" | grep -- '-ARCH$' | sort -V | tail -1)
  [[ $kver == 7.3.* ]] || fail "unexpected kernel release $kver"
  [[ -f $T/usr/lib/modules/$kver/dtbs/t6041-j616c.dtb ]] || fail "the kernel has no t6041-j616c.dtb"
  log "kernel $kver"
  [[ $(ls "$T/usr/lib/modules") == "$kver" ]] || fail "more than one kernel is installed: $(ls "$T/usr/lib/modules")"

  log "checking the UKI carries the new kernel"
  local uki=$T/boot/efi/EFI/Linux/omarchy_linux-aurora.efi
  [[ -s $uki ]] || fail "no UKI at ${uki#$T}"
  python3 - "$uki" "$kver" <<'PY' || fail "the UKI does not carry $kver"
import sys
data = open(sys.argv[1], "rb").read()
raise SystemExit(0 if sys.argv[2].encode() in data else 1)
PY

  log "Stage 2 from aura $STAGE2_COMMIT, kept for every later update-m1n1"
  install -D -m 0644 /stage2.bin "$T$STAGE2_PATH"
  [[ -f $T/etc/default/update-m1n1 ]] || fail "the image has no /etc/default/update-m1n1"
  grep -q '^M1N1=' "$T/etc/default/update-m1n1" && fail "/etc/default/update-m1n1 already sets M1N1"
  printf '\n# J616c: aura releases up to 1.0.0b13.1 leave a post-M4 ANS powered off for\n# U-Boot (fixed in aura aaec599f). Remove once the aura package has that fix.\nM1N1=%s\n' \
    "$STAGE2_PATH" >>"$T/etc/default/update-m1n1"
  echo "aura Stage 2 $STAGE2_COMMIT $STAGE2_SHA256" >>"$W/versions.txt"
  echo "qemu-user-static from omarchy-pkgs $QEMU_PR_COMMIT (omacom/omarchy-pkgs#3505)" >>"$W/versions.txt"

  log "updates: Stage 2 rebuilt from the pin and tried once (OMS-13)"
  # The pacman hook must keep rebuilding Stage 2, and nothing may hold the kernel
  # or Mesa back: those are the hand guards this image replaces.
  ! grep -q '^[[:space:]]*M1N1_UPDATE_DISABLED' "$T/etc/default/update-m1n1" ||
    fail "/etc/default/update-m1n1 disables Stage 2 rebuilds"
  [[ -f $T/usr/share/libalpm/hooks/95-m1n1-install.hook ]] || fail "Aurora's Stage 2 pacman hook is missing"
  # pacman's resolved configuration, Include= files and all.
  local ignored groups hookdirs dir
  hookdirs=$(in_chroot pacman-conf HookDir) || fail "pacman-conf could not read pacman's configuration"
  for dir in /etc/pacman.d/hooks $hookdirs; do
    [[ $dir == /usr/share/libalpm/hooks || $dir == /usr/share/libalpm/hooks/ ]] && continue
    [[ ! -e $T$dir/95-m1n1-install.hook && ! -L $T$dir/95-m1n1-install.hook ]] ||
      fail "$dir overrides Aurora's Stage 2 pacman hook"
  done
  ignored=$(in_chroot pacman-conf IgnorePkg | sort -u | tr '\n' ' ') || fail "pacman-conf could not read IgnorePkg"
  [[ $ignored == "m1n1-aurora " ]] || fail "pacman's IgnorePkg is not exactly m1n1-aurora: ${ignored:-(none)}"
  groups=$(in_chroot pacman-conf IgnoreGroup | tr '\n' ' ') || fail "pacman-conf could not read IgnoreGroup"
  [[ -z $groups ]] || fail "pacman ignores package groups: $groups"
  # Aurora's trial: the boot after a rebuild runs the candidate once; this commits
  # it once Linux is up, and the guard returns an uncommitted one after 12 minutes
  # (counted from unlock, below).
  in_chroot systemctl enable aurora-stage2-commit.service aurora-stage2-guard.timer >>"$W/pacman.log" 2>&1 ||
    fail "could not enable Aurora's Stage 2 trial units"
  [[ $(in_chroot systemctl is-enabled aurora-stage2-commit.service aurora-stage2-guard.timer | tr '\n' ' ') == "enabled enabled " ]] ||
    fail "Aurora's Stage 2 trial units are not enabled"
  # The guard's 12 minutes count from kernel start, so a slow disk password can
  # use them up before the commit service runs (OMS-17). The drop-in counts them
  # from the timer's activation in the unlocked system instead. It replaces this
  # exact trigger, so stop if Aurora's timer has changed.
  local guard_timer=$T/usr/lib/systemd/system/aurora-stage2-guard.timer triggers
  [[ -f $guard_timer ]] || fail "asahi-scripts no longer ships aurora-stage2-guard.timer; recheck its OMS-17 drop-in"
  # Every trigger, OnCalendar= included: the drop-in's empty OnBootSec= resets them all.
  [[ $(grep -E '^[[:space:]]*On[A-Za-z]+[[:space:]]*=' "$guard_timer") == "OnBootSec=12min" ]] ||
    fail "Aurora's aurora-stage2-guard.timer no longer triggers on OnBootSec=12min alone; recheck its OMS-17 drop-in"
  install -D -m 0644 /tools/image/aurora-stage2-guard-from-unlock.conf \
    "$T/usr/local/lib/systemd/system/aurora-stage2-guard.timer.d/aurora-stage2-guard-from-unlock.conf"
  # What systemd will merge, in order: Aurora's trigger, then the drop-in's reset
  # and its own, with nothing from another unit file or drop-in in between or after.
  triggers=$(in_chroot systemd-analyze cat-config systemd/system/aurora-stage2-guard.timer |
    grep -E '^[[:space:]]*On[A-Za-z]+[[:space:]]*=' | tr '\n' ' ') ||
    fail "systemd-analyze could not read aurora-stage2-guard.timer"
  [[ $triggers == "OnBootSec=12min OnBootSec= OnActiveSec=12min " ]] ||
    fail "aurora-stage2-guard.timer's merged triggers aren't Aurora's plus the OMS-17 drop-in: $triggers"
  install -D -m 0644 /dev/stdin "$T/etc/omarchy-mac-boot/owner-boot-chain" <<EOF
aurora-silicon aura-$STAGE2_COMMIT
Stage 2 from aura $STAGE2_COMMIT (pinned in /etc/default/update-m1n1), built by
Aurora's update-m1n1 into m1n1/boot-ctxr.bin. Omarchy's boot check rebuilds Stage 2 the stock way and can't verify this one, so
omarchy update warns instead of refusing (omarchy-mac-boot update-verify). Aurora's
Stage 2 trial checks each rebuilt Stage 2 at the next boot instead. Remove this file
and the M1N1= line once the boot check understands Aurora's chain and an aura release
contains aaec599f (omarchy-m4 OMS-13).
EOF

  log "Stage 2: standard and J616c confined"
  printf '%s\0' $J616C_COMPATIBLE >"$T/tmp/j616c-compatible"
  [[ -f $T/usr/share/aura/monitor-free ]] || fail "aura ships no monitor-free marker"
  in_chroot env TARGET=/boot/efi/m1n1/boot.bin AURORA_DEVICE_TREE_COMPATIBLE=/nonexistent \
    /usr/bin/update-m1n1 >"$W/update-m1n1.log" 2>&1 || fail "update-m1n1 failed (update-m1n1.log)"
  in_chroot env TARGET=/boot/efi/m1n1/boot-ctxr-j616c.bin AURORA_DEVICE_TREE_COMPATIBLE=/tmp/j616c-compatible \
    /usr/bin/update-m1n1 >>"$W/update-m1n1.log" 2>&1 || fail "update-m1n1 for J616c failed (update-m1n1.log)"
  [[ -s $T/boot/efi/m1n1/boot.bin && -s $T/boot/efi/m1n1/boot-ctxr-j616c.bin ]] || fail "no Stage 2 written"
  rm -f "$T/boot/efi/m1n1/boot-ctxr.bin" "$T/boot/efi/m1n1/boot.bin.old"
  # Defensive: the pacman hook can't arm a Stage 2 trial in this build (its
  # device tree names no Apple board and no aura Stage 1), but should it ever,
  # a fresh install must not commit a candidate built before the pin, or carry
  # its receipt, displaced candidates or attempt records.
  trial_state() {
    (cd "$T" && find boot/efi -maxdepth 1 -name 'aura-try*' -print 2>/dev/null
      find boot/efi/m1n1 \( -name '*.next' -o -name '*.next.json' -o -name '*.failed-*' \) -print 2>/dev/null
      find var/lib/aurora-stage2/attempts -mindepth 1 -maxdepth 1 -print 2>/dev/null) || true
  }
  local stale
  stale=$(trial_state)
  if [[ -n $stale ]]; then
    log "removing Stage 2 trial state left by the build: $(tr '\n' ' ' <<<"$stale")"
    while IFS= read -r p; do
      [[ -n $p && $p != /* && $p != *..* ]] || continue # never the image root or outside it
      rm -rf -- "${T:?}/$p"
    done <<<"$stale"
  fi
  [[ -z $(trial_state) ]] || fail "Stage 2 trial state remains in the image: $(trial_state | tr '\n' ' ')"
  python3 - "$T/boot/efi/m1n1/boot-ctxr-j616c.bin" "$T/usr/lib/modules/$kver/dtbs/t6041-j616c.dtb" \
    "$T/usr/lib/asahi-boot/u-boot-nodtb.bin" <<'PY' || fail "the J616c Stage 2 lacks its tree or U-Boot"
import gzip, sys
stage2 = open(sys.argv[1], "rb").read()
dtb = open(sys.argv[2], "rb").read()
uboot = open(sys.argv[3], "rb").read()
def contains(blob):
    if blob in stage2:
        return True
    # update-m1n1 may gzip payloads; look inside every gzip member.
    i = 0
    while (i := stage2.find(b"\x1f\x8b\x08", i)) >= 0:
        try:
            if blob in gzip.decompress(stage2[i:]):
                return True
        except Exception:
            pass
        i += 3
    return False
raise SystemExit(0 if contains(dtb) and contains(uboot) else 1)
PY
  for p in boot.bin boot-ctxr-j616c.bin; do
    cmp -s -n "$(stat -c %s /stage2.bin)" /stage2.bin "$T/boot/efi/m1n1/$p" || fail "m1n1/$p does not start with the aura $STAGE2_COMMIT Stage 2"
  done
  if (($(stat -c %s "$T/boot/efi/m1n1/boot-ctxr-j616c.bin") > 16 * 1024 * 1024)); then
    fail "the confined Stage 2 exceeds aura's 16 MiB slot"
  fi

  log "Stage 1: aura's raw image"
  # The J616c enrolls this raw image after `bputil -nc` (the installer's raw-ctxr
  # mode, OMS-24). Its Mach-O boot object isn't staged: padded it reboots this
  # chip silently, unpadded aura's Stage 2 refuses to start the OS (JOURNEY 9.30-9.31).
  install -D -m 0644 "$T/usr/share/aura/stage1/aura-raw.bin" "$T/boot/efi/aurora/stage1-j616c.bin"
  # The builder's MacBook Neo contract (stage_board_boot_payloads): its raw
  # Stage 1 comes from the package that ships Stage 2, and boot-j700.bin is the
  # common bundle. m1n1-aurora is gone, so both now come from aura.
  install -m 0644 "$T/usr/share/aura/stage1/aura-raw.bin" "$T/boot/efi/aurora/stage1-j700.bin"
  install -m 0644 "$T/boot/efi/m1n1/boot.bin" "$T/boot/efi/m1n1/boot-j700.bin"

  log "owner setup: trust Aurora's key in the Mac's own keyring"
  install -D -m 0644 /dev/stdin "$T/etc/systemd/system/omarchy-provision-owner.service.d/30-aurora-keyring.conf" <<'EOF'
# First boot builds this Mac's pacman keyring from archlinuxarm, asahi-alarm and
# omarchy only. Add Aurora's (aurora-keyring) before owner setup, or pacman asks
# to import its key on a prompt nobody sees and setup stalls.
[Service]
ExecStartPre=/usr/bin/pacman-key --populate aurora
EOF

  log "mounting /boot/efi and /boot from the install the Mac boots"
  # fstab stays as the image builder writes it (mac-image-check pins the line);
  # the generator's units take precedence over fstab's at every boot.
  # The generator copies these lines' UUIDs, options and fsck pass, so match all of them.
  grep -Eq '^UUID=4F4D-5801[[:space:]]+/boot/efi[[:space:]]+vfat[[:space:]]+umask=0077[[:space:]]+0[[:space:]]+2[[:space:]]*$' "$T/etc/fstab" ||
    fail "fstab's /boot/efi line isn't the one omarchy-esp-generator replaces (UUID=4F4D-5801, umask=0077, pass 2)"
  grep -Eq '^UUID=4f4d5801-424f-4f54-8000-000000000001[[:space:]]+/boot[[:space:]]+ext4[[:space:]]+defaults,noatime[[:space:]]+0[[:space:]]+2[[:space:]]*$' "$T/etc/fstab" ||
    fail "fstab's /boot line isn't the one omarchy-esp-generator replaces (UUID=4f4d5801-424f-…-0001, defaults,noatime, pass 2)"
  install -D -m 0755 /tools/image/omarchy-esp-generator \
    "$T/usr/local/lib/systemd/system-generators/omarchy-esp-generator"

  log "cleaning up the root"
  rm -rf "$T/etc/pacman.d/gnupg"
  find "$T/var/cache/pacman/pkg" -mindepth 1 -delete
  rm -f "$T/etc/resolv.conf"
  [[ -z $resolv_backup ]] || cp -a "$resolv_backup" "$T/etc/resolv.conf"
  rm -f "$T/boot/efi/.builder"
  find "$T/etc" -name '*.pacnew' | tee "$W/pacnew.txt"

  log "replacing the Recovery app with one that knows raw-ctxr"
  local recovery_dir=$T/boot/efi/aurora/recovery
  [[ -d $recovery_dir ]] || fail "the edge image carries no native Recovery app"
  rm -rf -- "$recovery_dir" && mkdir -p "$recovery_dir"
  cp -R "/recovery/Omarchy Installer.app" "$recovery_dir/"
  install -m 0644 /recovery/omarchy-recovery-app.json "$recovery_dir/omarchy-recovery-app.json"
  # A 30-byte literal: Swift inlines strings of 15 bytes or fewer, which then
  # don't appear in the binary as one run of bytes.
  grep -aq 'raw-ctxr/aura-raw.bin' "$recovery_dir/Omarchy Installer.app/Contents/MacOS/OmarchyRecovery" ||
    fail "the Recovery app does not know the raw-ctxr mode"

  log "copying the ESP out"
  rm -rf "$W/payload/esp" && mkdir "$W/payload/esp"
  cp -a "$T/boot/efi/." "$W/payload/esp/"

  log "re-sealing @factory"
  local sealed
  sealed=$(cat "$W/top/@factory/var/lib/omarchy/factory-sealed")
  local i
  for ((i = ${#mounts[@]} - 1; i >= 0; i--)); do
    [[ ${mounts[i]} == "$W/top" ]] && continue
    umount -l "${mounts[i]}"
    unset 'mounts[i]'
  done
  mounts=("$W/top")
  btrfs property set -ts "$W/top/@factory" ro false
  btrfs subvolume delete "$W/top/@factory" >/dev/null
  btrfs subvolume snapshot "$W/top/@" "$W/top/@factory.new" >/dev/null
  local new=$W/top/@factory.new
  rm -rf -- "$new/var/lib/omarchy/first-boot" "$new/var/lib/omarchy/mac-first-boot" \
    "$new/var/lib/omarchy/provisioning/pending" "$new/etc/pacman.d/gnupg" "$new/var/lib/omarchy/backups" \
    "$new/var/cache/pacman/pkg/"* \
    "$new/etc/NetworkManager/system-connections/"* "$new/var/lib/NetworkManager/"* "$new/var/lib/iwd"
  install -d -m 0755 "$new/var/lib/omarchy"
  printf '%s\n' "$sealed" >"$new/var/lib/omarchy/factory-sealed"
  chmod 0644 "$new/var/lib/omarchy/factory-sealed"
  btrfs property set -ts "$new" ro true
  mv -T "$new" "$W/top/@factory"
  btrfs filesystem sync "$W/top"
  local free
  free=$(btrfs filesystem usage -b "$W/top" 2>/dev/null | awk '/Free \(estimated\)/ { print $3; exit }')
  log "root free space: $free bytes"
  [[ $free =~ ^[0-9]+$ ]] && ((free >= 512 * 1024 * 1024)) || fail "too little free space left in the root"
  cleanup
  mounts=()
  loops=()
  e2fsck -fn "$W/payload/boot.img" >/dev/null || fail "boot.img does not check clean"
  btrfs check --readonly "$W/payload/root.img" >/dev/null 2>&1 || fail "root.img does not check clean"

  log "packaging"
  name=$(basename "$zip" | sed 's/-mac-edge-os-package\.zip$/-mac-edge-j616c-dev-os-package.zip/')
  [[ $name != "$(basename "$zip")" ]] || fail "unexpected payload name"
  (cd "$W/payload" && bsdtar --format zip -cf "/out/$name" esp boot.img root.img omarchy-volume.icns)
  python3 - "$data" "/out/installer_data.json" "$name" <<'PY'
import json, sys
data = json.load(open(sys.argv[1]))
[target] = data["os_list"]
target["package"] = sys.argv[3]
json.dump(data, open(sys.argv[2], "w"), indent=2)
open(sys.argv[2], "a").write("\n")
PY
  cp "$W/versions.txt" "$W/pacman.log" "$W/update-m1n1.log" "$W/keyring.log" "$W/pacnew.txt" /out/
  (cd /out && sha256sum "$name" >"$name.sha256" && stat -c '%s %n' "$name")
  log "done"
}

if [[ ${1:-} == --in-container ]]; then
  container
else
  host "$@"
fi
